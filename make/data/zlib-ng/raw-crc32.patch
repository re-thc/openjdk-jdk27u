@@ -73,6 +97,7 @@ int32_t Z_EXPORT PREFIX(inflateResetKeep)(PREFIX3(stream) *strm) {
         strm->adler = state->wrap & 1;
     state->mode = HEAD;
     state->check = ADLER32_INITIAL_VALUE;
+    if (state->raw_crc.copy) { raw_crc_reset(&state->raw_crc); strm->adler = 0; }

 }
 
+template <typename C>
+void check_no_whitespace() {
+  for (bool url : {false, true}) {
+    const auto option = url ? simdutf::base64_url_no_whitespace
+                            : simdutf::base64_default_no_whitespace;
+    const auto original = url ? simdutf::base64_url : simdutf::base64_default;
+    for (size_t size : {4, 60, 64, 68, 128, 256, 1024}) {
+      std::basic_string<C> input(size, C('A'));
+      std::vector<char> output(size + 16, char(0x55));
+      size_t count = size;
+      auto r = simdutf::base64_to_binary_safe(input.data(), size, output.data(), count,
+                                             option, simdutf::only_full_chunks);
+      ASSERT_EQUAL(r.error, simdutf::SUCCESS);
+      ASSERT_EQUAL(r.count, size);
+      ASSERT_EQUAL(count, size / 4 * 3);
+      for (size_t at = 0; at < size; at++) {
+        for (char bad : {' ', '\t', '\r', '\n', '\f', '!'}) {
+          input[at] = C(bad);
+          count = size;
+          std::fill(output.begin(), output.end(), char(0x55));
+          r = simdutf::base64_to_binary_safe(input.data(), size, output.data(), count, option);
+          ASSERT_TRUE(r.error != simdutf::SUCCESS);
+          for (size_t i = size; i < output.size(); i++) ASSERT_EQUAL(output[i], char(0x55));
+          input[at] = C('A');
+        }
+      }
+      input.insert(size / 2, 4, C(' '));
+      count = size;
+      r = simdutf::base64_to_binary_safe(input.data(), input.size(), output.data(), count, original);
+      ASSERT_EQUAL(r.error, simdutf::SUCCESS);
+      ASSERT_EQUAL(count, size / 4 * 3);
+    }
+    // The JDK block caller derives consumed quartets from complete output groups.
+    for (size_t prefix : {0, 60, 64, 256}) {
+      for (const char* tail : {"", "A", "AA", "AAA", "AA==", "AAA=", "AA=", "AA= =", "AAAA "}) {
+        std::basic_string<C> input(prefix, C('A'));
+        input.append(tail, tail + std::strlen(tail));
+        for (size_t capacity : {size_t(0), size_t(3), prefix / 4 * 3, input.size()}) {
+          std::vector<char> output(capacity + 16, char(0x55));
+          size_t count = capacity;
+          auto r = simdutf::base64_to_binary_safe(input.data(), input.size(), output.data(),
+                                                 count, option, simdutf::only_full_chunks);
+          if (r.error == simdutf::SUCCESS) {
+            ASSERT_EQUAL(count % 3, 0);
+            ASSERT_EQUAL(r.count, count / 3 * 4);
+          }
+          for (size_t i = capacity; i < output.size(); i++) ASSERT_EQUAL(output[i], char(0x55));
+        }
+      }
+    }
+    for (const char* text : {"AA==", "AAA=", "AA", "AAA"}) {
+      std::basic_string<C> input(text, text + std::strlen(text));
+      char output[16]; size_t count = sizeof(output);
+      auto r = simdutf::base64_to_binary_safe(input.data(), input.size(), output, count, option);
+      ASSERT_EQUAL(r.error, simdutf::SUCCESS);
+    }
+    for (const char* text : {"AA= =", " AA==", "AA== ", "AA==A", "A===", "AA="}) {
+      std::basic_string<C> input(text, text + std::strlen(text));
+      char output[16]; size_t count = sizeof(output);
+      auto r = simdutf::base64_to_binary_safe(input.data(), input.size(), output, count, option);
+      ASSERT_TRUE(r.error != simdutf::SUCCESS);
+    }
+  }
+}
+TEST(base64_no_whitespace) {
+  check_no_whitespace<char>();
+  check_no_whitespace<char16_t>();
+}

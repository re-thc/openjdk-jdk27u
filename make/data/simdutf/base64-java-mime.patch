diff --git a/tests/base64_tests.cpp b/tests/base64_tests.cpp
index 9e114e0..f7a19b2 100644
--- a/tests/base64_tests.cpp
+++ b/tests/base64_tests.cpp
@@ -4205,6 +4205,52 @@ TEST(base64_no_whitespace) {
   check_no_whitespace<char16_t>();
 }
 
+TEST(base64_java_mime) {
+  for (const char *bad : {"AA==A", "AA= =", "A===", "AA=", "=", "A", "AAA==A"}) {
+    for (size_t prefix : {0, 60, 64, 256, 1024}) {
+      std::string input(prefix, 'A'); input += bad;
+      std::vector<char> output(input.size() + 16, char(0x55));
+      size_t count = input.size();
+      auto r = simdutf::base64_to_binary_safe(input.data(), input.size(), output.data(), count, simdutf::base64_java_mime);
+      ASSERT_TRUE(r.error != simdutf::SUCCESS);
+      for (size_t i = input.size(); i < output.size(); i++) ASSERT_EQUAL(output[i], char(0x55));
+    }
+  }
+  for (size_t size : {0,1,2,3,31,63,64,65,255,256,1024,8192}) {
+    std::string raw(size, 'x');
+    std::string encoded(simdutf::base64_length_from_binary(size), '\0');
+    simdutf::binary_to_base64(raw.data(), size, encoded.data());
+    std::string mime;
+    for (size_t i = 0; i < encoded.size(); i++) {
+      if (encoded[i] != '=' && i % 7 == 0) mime += "! \r\n\t\f_\xff";
+      mime += encoded[i];
+    }
+    mime += "!\r\n";
+    for (size_t cap : {size, size + 128}) {
+      std::vector<char> output(cap + 16, char(0x55)); size_t count = cap;
+      auto r = simdutf::base64_to_binary_safe(mime.data(), mime.size(), output.data(), count, simdutf::base64_java_mime);
+      ASSERT_EQUAL(r.error, simdutf::SUCCESS); ASSERT_EQUAL(count, size);
+      ASSERT_TRUE(std::equal(raw.begin(), raw.end(), output.begin()));
+      for (size_t i = size; i < output.size(); i++) ASSERT_EQUAL(output[i], char(0x55));
+      std::u16string wide(mime.begin(), mime.end());
+      count = cap;
+      r = simdutf::base64_to_binary_safe(wide.data(), wide.size(), output.data(), count, simdutf::base64_java_mime);
+      ASSERT_EQUAL(r.error, simdutf::SUCCESS); ASSERT_EQUAL(count, size);
+    }
+    if (size > 0) {
+      std::vector<char> output(size + 16, char(0x55)); size_t count = size - 1;
+      auto r = simdutf::base64_to_binary_safe(mime.data(), mime.size(), output.data(), count, simdutf::base64_java_mime);
+      ASSERT_EQUAL(r.error, simdutf::OUTPUT_BUFFER_TOO_SMALL);
+      for (size_t i = size - 1; i < output.size(); i++) ASSERT_EQUAL(output[i], char(0x55));
+    }
+  }
+  for (const char *good : {"AA", "AAA", "A!A==", "AA==!", "AA===", "!!"}) {
+    char output[16]; size_t count = sizeof(output);
+    auto r = simdutf::base64_to_binary_safe(good, std::strlen(good), output, count, simdutf::base64_java_mime);
+    ASSERT_EQUAL(r.error, simdutf::SUCCESS);
+  }
+}

include MakeIncludeStart.gmk
ifeq ($(INCLUDE), true)

CASEINSENSITIVEMAP := $(SUPPORT_OUTPUTDIR)/gensrc/java.xml/com/sun/org/apache/xerces/internal/impl/xpath/regex/CaseInsensitiveMap.java
CASEINSENSITIVEMAP_TEMPLATE := $(MODULE_SRC)/share/classes/com/sun/org/apache/xerces/internal/impl/xpath/regex/CaseInsensitiveMap.java.template
CASEINSENSITIVEMAP_UNICODEDATA := $(TOPDIR)/src/java.base/share/data/unicodedata
CASEINSENSITIVEMAP_CHARACTER := $(TOPDIR)/src/java.base/share/classes/java/lang/Character.java

$(CASEINSENSITIVEMAP): $(BUILD_TOOLS_JDK) $(CASEINSENSITIVEMAP_TEMPLATE) \
    $(CASEINSENSITIVEMAP_UNICODEDATA)/UnicodeData.txt \
    $(CASEINSENSITIVEMAP_UNICODEDATA)/ReadMe.txt $(CASEINSENSITIVEMAP_CHARACTER)
	$(call LogInfo, Generating $@)
	$(call MakeTargetDir)
	$(TOOL_GENERATECASEINSENSITIVEMAP) $(CASEINSENSITIVEMAP_TEMPLATE) \
	    $(CASEINSENSITIVEMAP_UNICODEDATA)/UnicodeData.txt \
	    $(CASEINSENSITIVEMAP_UNICODEDATA)/ReadMe.txt \
	    $(CASEINSENSITIVEMAP_CHARACTER) $@

TARGETS += $(CASEINSENSITIVEMAP)

endif # include guard
include MakeIncludeEnd.gmk

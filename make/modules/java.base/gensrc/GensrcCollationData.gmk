include MakeIncludeStart.gmk
ifeq ($(INCLUDE), true)
include CollationData.gmk

$(COLLATION_IDENTITY_DONE): $(COLLATION_INPUTS) $(COLLATION_INPUT_LIST_DEP) $(BUILD_TOOLS_JDK)
	$(call MakeDir, $(dir $(COLLATION_IDENTITY)) $(COLLATION_METADATA))
	$(call LogInfo, Generating target collation input identity)
	$(TOOL_GENERATECOLLATIONIDENTITY) $(TOPDIR) $(COLLATION_IDENTITY) $(COLLATION_METADATA)
	$(TOUCH) $@

# The stamp records successful generation even when an unchanged input was
# merely touched and writeIfChanged preserves the generated source timestamp.
$(COLLATION_IDENTITY): $(COLLATION_IDENTITY_DONE)
	@test -f $@ || $(TOOL_GENERATECOLLATIONIDENTITY) $(TOPDIR) $@ $(COLLATION_METADATA)

TARGETS += $(COLLATION_IDENTITY_DONE) $(COLLATION_IDENTITY)

endif
include MakeIncludeEnd.gmk

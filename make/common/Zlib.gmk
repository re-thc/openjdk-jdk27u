include MakeIncludeStart.gmk
ifeq ($(INCLUDE), true)

ifeq ($(USE_ZLIBNG), true)
  ZLIBNG_SRC := $(TOPDIR)/src/java.base/share/native/libzip/zlib-ng
  ZLIBNG_OUT := $(SUPPORT_OUTPUTDIR)/native/zlib-ng$(if $(filter true, $(STATIC_LIBS)),-static)
  ZLIBNG_LIB := $(ZLIBNG_OUT)/$(if $(filter windows, $(OPENJDK_TARGET_OS)),zlibstatic-ng.lib,libz-ng.a)
  ZLIBNG_HOST := $(OPENJDK_TARGET_CPU)-$(if $(filter macosx, $(OPENJDK_TARGET_OS)),apple-darwin,unknown-linux-gnu)

  $(ZLIBNG_LIB): $(call FindFiles, $(ZLIBNG_SRC)) $(SPEC) \
      $(TOPDIR)/make/common/Zlib.gmk \
      $(TOPDIR)/make/scripts/zlib-ng-cmake-flags.sh
	# Upstream makefiles do not track all configuration/header dependencies.
	$(RM) -r $(ZLIBNG_OUT)
	$(MKDIR) -p $(ZLIBNG_OUT)
  ifeq ($(call isTargetOs, windows), true)
	$(BASH) $(TOPDIR)/make/scripts/zlib-ng-cmake-flags.sh \
	    $(ZLIBNG_OUT)/jdk-flags.cmake $(FIXPATH_BASE) \
	    --cflags $(CFLAGS_JDKLIB) $(SYSROOT_CFLAGS) \
	    --ldflags $(LDFLAGS_JDKEXE) $(SYSROOT_LDFLAGS)
	MAKEFLAGS= MFLAGS= $(CMAKE) -C $(ZLIBNG_OUT)/jdk-flags.cmake -S $(ZLIBNG_SRC) -B $(ZLIBNG_OUT) -G "NMake Makefiles" \
	    -DCMAKE_MAKE_PROGRAM="$(call FixPath, $(lastword $(NMAKE)))" \
	    "-DCMAKE_C_COMPILER=$(subst $(SPACE),;,$(call FixPath, $(subst $(FIXPATH) ,,$(CC))))" \
	    -DCMAKE_AR="$(call FixPath, $(lastword $(LIB)))" \
	    -DCMAKE_LINKER="$(call FixPath, $(lastword $(LD)))" \
	    -DCMAKE_BUILD_TYPE=Release -DCMAKE_TRY_COMPILE_CONFIGURATION=Release \
	    -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTING=OFF \
	    -DZLIB_COMPAT=OFF -DZLIB_SYMBOL_PREFIX=jdk_ng_native_ \
	    > $(ZLIBNG_OUT)/configure-output.log 2>&1 || { \
	      $(CAT) $(ZLIBNG_OUT)/configure-output.log; exit 1; \
	    }
	MAKEFLAGS= MFLAGS= $(CMAKE) --build $(ZLIBNG_OUT) --target zlib-ng
  else
	# Keep compiler environment assignments intact during configure probes.
	$(PRINTF) '%s\n' '#!/bin/sh' 'exec env $(CC) "$$@"' > $(ZLIBNG_OUT)/cc
	$(CHMOD) +x $(ZLIBNG_OUT)/cc
	cd $(ZLIBNG_OUT) && CC="$(ZLIBNG_OUT)/cc" AR="$(AR)" \
	    CFLAGS="$(CFLAGS_JDKLIB) $(SYSROOT_CFLAGS) -fPIC -Wno-undef" \
	    LDFLAGS="$(LDFLAGS_JDKLIB) $(SYSROOT_LDFLAGS)" CHOST="$(ZLIBNG_HOST)" \
	    $(BASH) $(ZLIBNG_SRC)/configure --static --sprefix=jdk_ng_native_ \
	    > configure-output.log 2>&1 || { \
	      $(CAT) $(ZLIBNG_OUT)/configure-output.log $(ZLIBNG_OUT)/configure.log; \
	      exit 1; \
	    }
	+$(MAKE) -C $(ZLIBNG_OUT) libz-ng.a
  endif

  # Both libzip and libjli use this native API and generated private symbol
  # mapping. Static consumers leave references for the single packaged engine.
  ZLIBNG_HEADER_CFLAGS := -I$(ZLIBNG_OUT)
  ifneq ($(STATIC_LIBS), true)
    ZLIBNG_LINK_LIBS := $(ZLIBNG_LIB)
  endif
endif

endif # include guard
include MakeIncludeEnd.gmk

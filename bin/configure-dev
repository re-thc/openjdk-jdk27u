# Use the repository's native development profile with the upstream configure.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
options=(
  --enable-jvm-feature-serialgc
  --enable-jvm-feature-g1gc
  --enable-jvm-feature-zgc
  --disable-jvm-feature-epsilongc
  --disable-jvm-feature-parallelgc
  --disable-jvm-feature-shenandoahgc
)

case "$(uname -s):$(uname -m)" in
  Linux:x86_64)
    cpu_flags='-march=x86-64-v3 -mtune=generic'
    ;;
  Linux:aarch64)
    cpu_flags='-march=armv8.2-a -mtune=generic'
    ;;
  Darwin:arm64)
    cpu_flags='-mcpu=apple-m1'
    ;;
  MINGW*:x86_64 | MSYS*:x86_64 | CYGWIN*:x86_64)
    cpu_flags='-arch:AVX2'
    ;;
  *)
    echo 'Supported native targets: Linux x64/ARM64, macOS ARM64, Windows x64.' >&2
    exit 1
    ;;
esac
options+=("--with-extra-cflags=$cpu_flags" "--with-extra-cxxflags=$cpu_flags")

if [[ $(uname -s) == Linux ]]; then
  command -v mold >/dev/null || { echo 'Install mold before configuring this profile.' >&2; exit 1; }
  options+=(--enable-headless-only --with-extra-ldflags=-fuse-ld=mold)
fi

# OpenJDK already handles ccache's precompiled-header requirements.
if command -v ccache >/dev/null && [[ $(uname -s) != MINGW* && $(uname -s) != MSYS* && $(uname -s) != CYGWIN* ]]; then
  options+=(--enable-ccache)
fi

# Explicit caller options override these defaults using configure's normal rules.
exec bash "$repo_root/configure" "${options[@]}" "$@"

# Use the repository's native development profile with the upstream configure.
# Set CONFIGURE_DEV_NO_MOLD=1 to use the default linker on Linux.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
options=(
  --disable-desktop
  --enable-headless-only
  --enable-jvm-feature-serialgc
  --enable-jvm-feature-g1gc
  --enable-jvm-feature-zgc
  --disable-jvm-feature-epsilongc
  --disable-jvm-feature-parallelgc
  --disable-jvm-feature-shenandoahgc
)

case "$(uname -s):$(uname -m)" in
  Linux:x86_64)
    cpu_flags='-march=x86-64-v3 -mtune=generic'
    ;;
  Linux:aarch64)
    cpu_flags='-march=armv8.2-a -mtune=generic'
    ;;
  Darwin:arm64)
    cpu_flags='-mcpu=apple-m1'
    ;;
  MINGW*:x86_64 | MSYS*:x86_64 | CYGWIN*:x86_64)
    cpu_flags='-arch:AVX2'
    ;;
  *)
    echo 'Supported native targets: Linux x64/ARM64, macOS ARM64, Windows x64.' >&2
    exit 1
    ;;
esac
extra_cflags=$cpu_flags
extra_cxxflags=$cpu_flags
extra_ldflags=''

if [[ $(uname -s) == Linux && ${CONFIGURE_DEV_NO_MOLD:-0} != 1 ]]; then
  command -v mold >/dev/null || { echo 'Install mold before configuring this profile.' >&2; exit 1; }
  extra_ldflags='-fuse-ld=mold'
fi

# Append caller flags so an unrelated extra flag keeps the CPU/linker defaults.
caller_options=()
for option in "$@"; do
  case "$option" in
    --with-extra-cflags=*) extra_cflags+=" ${option#*=}" ;;
    --with-extra-cxxflags=*) extra_cxxflags+=" ${option#*=}" ;;
    --with-extra-ldflags=*) extra_ldflags+=" ${option#*=}" ;;
    --with-extra-cflags | --with-extra-cxxflags | --with-extra-ldflags | \
    --without-extra-cflags | --without-extra-cxxflags | --without-extra-ldflags)
      echo 'Specify extra flags with --with-extra-{c,cxx,ld}flags=FLAGS.' >&2
      exit 1
      ;;
    *) caller_options+=("$option") ;;
  esac
done
options+=("--with-extra-cflags=$extra_cflags" "--with-extra-cxxflags=$extra_cxxflags")
if [[ -n $extra_ldflags ]]; then
  options+=("--with-extra-ldflags=$extra_ldflags")
fi

# OpenJDK already handles ccache's precompiled-header requirements.
if command -v ccache >/dev/null && [[ $(uname -s) != MINGW* && $(uname -s) != MSYS* && $(uname -s) != CYGWIN* ]]; then
  options+=(--enable-ccache)
fi

# Other caller options use configure's normal override rules.
exec bash "$repo_root/configure" "${options[@]}" "${caller_options[@]}"

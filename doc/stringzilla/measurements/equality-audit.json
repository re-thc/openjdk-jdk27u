  "alignment_benchmark_source": "package org.openjdk.bench.java.lang;\nimport java.lang.reflect.Field;\nimport java.util.Arrays;\nimport java.util.concurrent.TimeUnit;\nimport org.openjdk.jmh.annotations.*;\nimport sun.misc.Unsafe;\n@BenchmarkMode(Mode.AverageTime) @OutputTimeUnit(TimeUnit.NANOSECONDS)\n@State(Scope.Thread)\npublic class StringZillaEqualityAlignment {\n    @Param({\"0\", \"8\", \"16\", \"24\"}) public int padding;\n    private String left, right;\n    private byte[] retained;\n    @Setup public void setup() throws Exception {\n        char[] chars = new char[4096]; Arrays.fill(chars, 'a');\n        Field f=Unsafe.class.getDeclaredField(\"theUnsafe\"); f.setAccessible(true);\n        Unsafe u=(Unsafe)f.get(null);\n        Field v=String.class.getDeclaredField(\"value\");v.setAccessible(true);\n        if (u.arrayIndexScale(Object[].class)!=4) throw new AssertionError(\"Expected compressed oops\");\n        long base=u.arrayBaseOffset(Object[].class), bytes=u.arrayBaseOffset(byte[].class);\n        Object[] refs=new Object[2];\n        for (int index=0;index<2;index++) {\n            for (int attempt=0;attempt<256;attempt++) {\n                retained=new byte[0];\n                String candidate=new String(chars);\n                refs[index]=v.get(candidate);\n                long address=(Integer.toUnsignedLong(u.getInt(refs,base+4*index))<<3)+bytes;\n                if ((address&63)==padding) {\n                    if (index==0) left=candidate; else right=candidate;\n                    break;\n                }\n            }\n        }\n        if(left==null||right==null) throw new AssertionError(\"Could not align arrays\");\n        long a=(Integer.toUnsignedLong(u.getInt(refs,base))<<3)+bytes;\n        long b=(Integer.toUnsignedLong(u.getInt(refs,base+4))<<3)+bytes;\n        System.out.println(\"array-data-mod64=\"+(a&63)+\",\"+(b&63));\n        if (!left.equals(right)) throw new AssertionError();\n    }\n    @Benchmark public boolean equals(){return left.equals(right);}\n}\n",

-            if (a_vec.u64 != b_vec.u64) return sz_false_k;
-        }
-    }
-#endif
+    // sz_u64_load supports arbitrary alignment in portable-load mode.
+    if (length >= SZ_SWAR_THRESHOLD) {
+        sz_u64_vec_t a_vec, b_vec;
+        for (; (sz_size_t)(a_end - a) >= 8; a += 8, b += 8) {

+/* Only an empty head followed by <=64-byte FINISH calls is eligible.
+ * Dictionary/parameter/ResetKeep/non-FINISH histories are excluded: their
+ * earlier tail hashes need not equal hashes of the final window contents.
+ */
+static int clear_small_hash(deflate_state *s) {
+    if (!s->small_reset_safe)
+        return 0;
+    PREFIX3(stream) *strm = s->strm;
+    uint32_t n = (uint32_t)strm->total_in;
+    if (MIN_ROLL_LEVEL <= 6 || s->level != 6 ||
+        s->strategy != Z_DEFAULT_STRATEGY || s->status != FINISH_STATE ||
+        s->last_flush != Z_FINISH || s->pending || strm->avail_in ||
+        strm->total_in > 64 || s->strstart != n || s->lookahead ||
+        (s->wrap != 0 && s->wrap != -1) || W_BITS(s) != MAX_WBITS ||
+        s->lit_bufsize != (1 << (8 + 6)) ||
+        (n != 0 && s->high_water < n + 3))
+        return 0;
+    for (uint32_t pos = 0; pos < n; pos++) {
+        uint32_t value = Z_U32_FROM_LE(zng_memread_4(s->window + pos));
+        uint32_t hash;
+        UPDATE_HASH_KNUTH(hash, value);
+        s->head[hash] = 0;
+    }
+    return 1;
+}

+/*
+ * @test id=serial
+ * @summary Static archive resolution is independent of common intrinsics and safepoint timing
+ * @requires vm.cds & vm.gc.Serial & vm.bits == "64" & (os.arch == "amd64" | os.arch == "aarch64")
+ * @library /test/lib
+ * @build jdk.test.whitebox.WhiteBox DeterministicDump
+ * @run driver jdk.test.lib.helpers.ClassFileInstaller jdk.test.whitebox.WhiteBox
+ * @run main/othervm/timeout=480 -Xbootclasspath/a:. -XX:+UnlockDiagnosticVMOptions
+ *      -XX:+WhiteBoxAPI CommonIntrinsicArchiveDeterminism Serial
+ */
+
+/*
+ * @test id=g1
+ * @summary Static archive resolution is independent of common intrinsics and safepoint timing
+ * @requires vm.cds & vm.gc.G1 & vm.bits == "64" & (os.arch == "amd64" | os.arch == "aarch64")
+ * @library /test/lib
+ * @build jdk.test.whitebox.WhiteBox DeterministicDump
+ * @run driver jdk.test.lib.helpers.ClassFileInstaller jdk.test.whitebox.WhiteBox
+ * @run main/othervm/timeout=480 -Xbootclasspath/a:. -XX:+UnlockDiagnosticVMOptions
+ *      -XX:+WhiteBoxAPI CommonIntrinsicArchiveDeterminism G1
+ */
+
+/*
+ * @test id=z
+ * @summary Static archive resolution is independent of common intrinsics and safepoint timing
+ * @requires vm.cds & vm.gc.Z & vm.bits == "64" & (os.arch == "amd64" | os.arch == "aarch64")
+ * @library /test/lib
+ * @build jdk.test.whitebox.WhiteBox DeterministicDump
+ * @run driver jdk.test.lib.helpers.ClassFileInstaller jdk.test.whitebox.WhiteBox
+ * @run main/othervm/timeout=480 -Xbootclasspath/a:. -XX:+UnlockDiagnosticVMOptions
+ *      -XX:+WhiteBoxAPI CommonIntrinsicArchiveDeterminism Z
+ */
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+import jdk.test.lib.cds.CDSArchiveUtils;
+
+public class CommonIntrinsicArchiveDeterminism {
+    public static void main(String[] args) throws Exception {
+        for (boolean compressed : new boolean[] { false, true }) {
+            ArrayList<String> base = new ArrayList<>(List.of(
+                    "-XX:+Use" + args[0] + "GC", "-XX:+UseFourByteObjectHeaders",
+                    "-Xmx128M", "-Xms128M", "-Xmn120M",
+                    "-XX:" + (compressed ? "+" : "-") + "UseCompressedOops"));
+            String ordinary = DeterministicDump.dump(base, "-XX:-UseCommonIntrinsics");
+            File archive = new File(ordinary + ".jsa");
+            DeterministicDump.HEADER_SIZE = CDSArchiveUtils.fileHeaderSize(archive);
+            String common = DeterministicDump.dump(base, "-XX:+UseCommonIntrinsics");
+            String safepoints = DeterministicDump.dump(base, "-XX:+UseCommonIntrinsics",
+                    "-XX:+UnlockDiagnosticVMOptions", "-XX:+SafepointALot",
+                    "-XX:GuaranteedSafepointInterval=1");
+            DeterministicDump.compare(ordinary, common, archive);
+            DeterministicDump.compare(ordinary, safepoints, archive);
+        }
+    }
+}

+KnownField big_integer_mag("java/math/BigInteger", "mag", "[I");
+
+vmIntrinsics::ID big_integer_workload(const Method* method, const intptr_t* args = nullptr) {
+  if (!CommonIntrinsics::enabled() || StubRoutines::compiler_stubs_initialized() ||
+      method->method_holder()->name() != vmSymbols::java_math_BigInteger()) {
+    return vmIntrinsics::_none;
+  }
+  // These Java computations use several kernels. Waiting for a later kernel
+  // leaves their initial products in Java; preparing on product size alone
+  // also charges isolated medium-sized products for the entire compiler blob.
+  Symbol* name = method->name();
+  Symbol* signature = method->signature();
+  if (name->equals("oddModPow") && signature->equals(
+          "(Ljava/math/BigInteger;Ljava/math/BigInteger;)Ljava/math/BigInteger;")) {
+    return vmIntrinsics::_montgomerySquare;
+  }
+  if (name->equals("squareKaratsuba") && signature->equals("()Ljava/math/BigInteger;")) {
+    return vmIntrinsics::_squareToLen;
+  }
+  if (args != nullptr && name->equals("multiplyKaratsuba") && signature->equals(
+          "(Ljava/math/BigInteger;Ljava/math/BigInteger;)Ljava/math/BigInteger;")) {
+    // Cold recursive products break even later with C1. Retain deferral for
+    // the smaller products that still finish faster in Java on their own.
+    const jint first_product_limbs = UseCompiler ? 120 : 104;
+    // Drop these raw oops before returning the ID to the blocking preparer.
+    NoSafepointVerifier nsv;
+    Arguments values(args, 2);
+    oop x = big_integer_mag.object(values.object());
+    oop y = big_integer_mag.object(values.object());
+    if (array_range(x, T_INT, 0, 0) && array_range(y, T_INT, 0, 0) &&
+        static_cast<jlong>(typeArrayOop(x)->length()) * typeArrayOop(y)->length() >=
+            first_product_limbs * first_product_limbs) {
+      return vmIntrinsics::_multiplyToLen;
+    }
+  }
+  return vmIntrinsics::_none;
+}

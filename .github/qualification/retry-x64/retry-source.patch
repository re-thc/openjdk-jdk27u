+bool CommonIntrinsics::cache_interpreter_call(vmIntrinsics::ID id, const intptr_t* args) {
+#if defined(COMPILER2) && (defined(AMD64) || defined(AARCH64))
+  if ((!UseCompiler && !InlineIntrinsics) || !is_init_completed() ||
+      !is_big_integer(id) || !needs_compiler_stubs(id) ||
+      StubRoutines::compiler_stubs_initialized() ||
+      !is_available_for_interpreter(id) || !vmIntrinsics::is_intrinsic_available(id)) {
+    return true;
+  }
+  // Modular exponentiation chains Montgomery calls. Delaying their setup
+  // prolongs the first modPow operation instead of avoiding unused work.
+  if (id == vmIntrinsics::_montgomeryMultiply || id == vmIntrinsics::_montgomerySquare) {
+    prepare(id);
+    return true;
+  }
+  // Only read integer arguments; no raw oop is retained across prepare().
+  // Slots are in the same expression-stack order used by the leaf adapters.
+  jlong work = 0;
+  auto limbs = [](intptr_t value) -> jlong {
+    jint n = static_cast<jint>(value);
+    return n > 0 ? MIN2(n, max_quadratic_limbs) : 0;
+  };
+  switch (id) {
+    case vmIntrinsics::_multiplyToLen: work = limbs(args[3]) * limbs(args[1]); break;
+    case vmIntrinsics::_squareToLen: work = limbs(args[2]) * limbs(args[2]) / 2; break;
+    case vmIntrinsics::_mulAdd: work = limbs(args[1]); break;
+    case vmIntrinsics::_bigIntegerRightShiftWorker:
+    case vmIntrinsics::_bigIntegerLeftShiftWorker: work = limbs(args[0]); break;
+    default: ShouldNotReachHere();
+  }
+  work = MAX2(static_cast<jlong>(1), MIN2(work, big_integer_warmup_work));
+  if (AtomicAccess::add(&big_integer_work, work) < big_integer_warmup_work) {
+    // The entry still contains the resolved method and its signature. Leaving
+    // its bytecode unset makes a later invocation revisit this safe VM frame.
+    return false;
+  }
+  prepare(id);
+#endif
+  return true;
+}

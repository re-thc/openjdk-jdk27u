+            MemorySessionImpl session = ((AbstractMemorySegmentImpl) symbol).sessionImpl();
+            session.acquire0();
+            try {
+                return (long) leaf.invokeExact(address(symbol), x);
+            } finally {
+                session.release0();
+            }
+        }
+
+        @ForceInline
+        private static float invokeF(MethodHandle leaf, SegmentAllocator allocator, MemorySegment symbol, float x) throws Throwable {
+            MemorySessionImpl session = ((AbstractMemorySegmentImpl) symbol).sessionImpl();
+            session.acquire0();
+            try {
+                return (float) leaf.invokeExact(address(symbol), x);
+            } finally {
+                session.release0();
+            }
+        }
+
+        @ForceInline
+        private static double invokeD(MethodHandle leaf, SegmentAllocator allocator, MemorySegment symbol, double x) throws Throwable {
+            MemorySessionImpl session = ((AbstractMemorySegmentImpl) symbol).sessionImpl();
+            session.acquire0();
+            try {
+                return (double) leaf.invokeExact(address(symbol), x);
+            } finally {
+                session.release0();
+            }
+        }
+
+        @ForceInline
+        private static int invokeII(MethodHandle leaf, SegmentAllocator allocator, MemorySegment symbol, int x, int y) throws Throwable {
+            MemorySessionImpl session = ((AbstractMemorySegmentImpl) symbol).sessionImpl();
+            session.acquire0();
+            try {
+                return (int) leaf.invokeExact(address(symbol), x, y);
+            } finally {
+                session.release0();
+            }
+        }

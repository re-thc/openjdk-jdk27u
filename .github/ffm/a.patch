+
+    private static class SimpleDowncall {
+        static MethodHandle specialize(MethodHandle leaf, CallingSequence cs) {
+            if (!cs.forDowncall() || cs.allocationSize() != 0 || cs.needsReturnBuffer() ||
+                    cs.capturedStateMask() != 0 || cs.usingAddressPairs() || cs.isVariadicFunction()) {
+                return null;
+            }
+            MethodType caller = cs.callerMethodType();
+            if (caller.parameterCount() == 0 || caller.parameterType(0) != MemorySegment.class ||
+                    !leaf.type().equals(caller.changeParameterType(0, long.class))) {
+                return null;
+            }
+            Class<?> type = caller.returnType();
+            int arity = caller.parameterCount() - 1;
+            String name;
+            if (type == void.class && arity == 0) {
+                name = "invokeV";
+            } else if (type == int.class && arity == 2 &&
+                    caller.parameterType(1) == int.class && caller.parameterType(2) == int.class) {
+                name = "invokeII";
+            } else if (arity == 1 && caller.parameterType(1) == type) {
+                if (type == int.class) name = "invokeI";
+                else if (type == long.class) name = "invokeJ";
+                else if (type == float.class) name = "invokeF";
+                else if (type == double.class) name = "invokeD";
+                else return null;
+            } else {
+                return null;
+            }
+            if (cs.argumentBindingsCount() != caller.parameterCount()) return null;
+            List<Binding> symbol = cs.argumentBindings(0);
+            if (symbol.size() != 2 || !(symbol.get(0) instanceof Binding.SegmentOffset offset) ||
+                    offset.allowHeap() || !(symbol.get(1) instanceof Binding.VMStore move) ||
+                    move.type() != long.class) return null;
+            for (int i = 1; i < cs.argumentBindingsCount(); i++) {
+                List<Binding> bindings = cs.argumentBindings(i);
+                if (bindings.size() != 1 || !(bindings.get(0) instanceof Binding.VMStore store) ||
+                        store.type() != caller.parameterType(i)) return null;
+            }
+            List<Binding> result = cs.returnBindings();
+            if (type == void.class ? !result.isEmpty() :
+                    (result.size() != 1 || !(result.get(0) instanceof Binding.VMLoad load) ||
+                            load.type() != type)) return null;
+            MethodType helperType = caller.insertParameterTypes(0, MethodHandle.class, SegmentAllocator.class);
+            return MhUtil.findStatic(MethodHandles.lookup(), SimpleDowncall.class, name, helperType).bindTo(leaf);
+        }

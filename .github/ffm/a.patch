+#include "shared.h"
+#include <stdint.h>
+#include <errno.h>
+#include <stdarg.h>
+EXPORT void noop(void) { }
+EXPORT int id_i(int x) { return x; }
+EXPORT int add_i(int x, int y) { return (int)((uint32_t)x + (uint32_t)y); }
+EXPORT long long id_j(long long x) { return x; }
+EXPORT float id_f(float x) { return x; }
+EXPORT double id_d(double x) { return x; }
+EXPORT int read_ptr(const int *x) { return *x; }
+EXPORT void *ptr_id(void *x) { return x; }
+EXPORT int8_t id_b(int8_t x) { return x; }
+EXPORT int16_t id_s(int16_t x) { return x; }
+EXPORT uint16_t id_c(uint16_t x) { return x; }
+static int (*blocker)(int);
+EXPORT void install_callback(int (*f)(int)) { blocker = f; }
+EXPORT int block_i(int x) { return blocker(x); }
+EXPORT int callback(int (*f)(int), int x) { return f(x); }
+EXPORT int set_errno(int x) { errno = x; return x; }
+struct pair { int x, y; };
+EXPORT struct pair pair_id(struct pair x) { return x; }
+EXPORT int sum_var(int x, ...) { va_list a; va_start(a, x); int y = va_arg(a, int); va_end(a); return x + y; }

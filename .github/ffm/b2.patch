+/*
+ * @test
+ * @summary Zero-sized copy bindings still have an arena context
+ * @modules java.base/jdk.internal.foreign.abi:+open
+ *          java.base/jdk.internal.foreign.abi.x64.windows:+open
+ * @run main/othervm --enable-native-access=ALL-UNNAMED TestZeroAllocationBindings
+ */
+
+import java.lang.foreign.FunctionDescriptor;
+import java.lang.foreign.MemoryLayout;
+import java.lang.foreign.MemorySegment;
+import java.lang.foreign.SegmentAllocator;
+import java.lang.invoke.MethodHandle;
+import java.lang.invoke.MethodHandles;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import jdk.internal.foreign.abi.ABIDescriptor;
+import jdk.internal.foreign.abi.Binding;
+import jdk.internal.foreign.abi.BindingSpecializer;
+import jdk.internal.foreign.abi.CallingSequence;
+import jdk.internal.foreign.abi.LinkerOptions;
+import jdk.internal.foreign.abi.x64.windows.CallArranger;
+
+public class TestZeroAllocationBindings {
+    public static void main(String[] args) throws Throwable {
+        FunctionDescriptor descriptor = FunctionDescriptor.ofVoid(MemoryLayout.structLayout());
+        CallingSequence sequence = CallArranger.getBindings(descriptor.toMethodType(), descriptor,
+                false, LinkerOptions.empty()).callingSequence();
+        if (sequence.allocationSize() != 0 ||
+                sequence.argumentBindings().noneMatch(b -> b instanceof Binding.Copy)) {
+            throw new AssertionError("Expected a zero-sized copy binding");
+        }
+        Field field = CallArranger.class.getDeclaredField("CWindows");
+        field.setAccessible(true);
+        ABIDescriptor abi = (ABIDescriptor)field.get(null);
+        Method specialize = BindingSpecializer.class.getDeclaredMethod("specializeDowncall",
+                MethodHandle.class, CallingSequence.class, ABIDescriptor.class);
+        specialize.setAccessible(true);
+        // A Java-only leaf exercises class generation without an ABI-specific native stub.
+        MethodHandle leaf = MethodHandles.empty(sequence.calleeMethodType());
+        MethodHandle handle = (MethodHandle)specialize.invoke(null, leaf, sequence, abi);
+        if (!handle.type().equals(sequence.callerMethodType()
+                .insertParameterTypes(0, SegmentAllocator.class))) {
+            throw new AssertionError(handle.type());
+        }
+    }
+}

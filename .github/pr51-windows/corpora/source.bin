    private static final int LAZY_SEARCH_STRENGTH = Math.max(1, Math.min(16,
            Integer.getInteger("jzstd.lazySearchStrength", 8)));
    private static final int LAZY_GAIN = Math.max(1,
            Integer.getInteger("jzstd.lazyGain", 3));

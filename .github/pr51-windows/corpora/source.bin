            Integer.getInteger("jzstd.lazySteps", 2));
    private static final boolean SUPPRESS_SEQUENCES = Boolean.getBoolean("jzstd.noseq");
    private static final boolean OPTIMAL_TRACE = Boolean.getBoolean("jzstd.optimalTrace");
    /** Debug: report matches the optimal parser emits below the profile minimum. */
    private static final boolean MIN_MATCH_DEBUG = Boolean.getBoolean("jzstd.minMatchDebug");
    private static final int LOW_ALPHABET_LIMIT = 32;
    private static final int LOW_ALPHABET_MIN_MATCH = 24;
    /**
     * Fraction of the uniform entropy {@code log2(distinct)} a small-alphabet block
     * must reach before its literals are treated as incompressible. Random four-symbol
     * data sits at 1.00; lowercase English text over 28 symbols sits at 0.86.
     */
    private static final double LOW_ALPHABET_UNIFORMITY = Math.max(0.0, Math.min(1.0,
            Double.parseDouble(System.getProperty("jzstd.lowAlphabetUniformity", "0.95"))));
    /**
     * Bits a sequence costs once its length, offset and literal-length codes are entropy
     * coded. Short-offset and repeat matches sit well below the thirty-odd bits an
     * explicit far offset needs, so this is deliberately the cheap end: it decides how
     * short a match may be before it stops paying for itself.
     */
    private static final int SEQUENCE_COST_BITS = Math.max(1,
            Integer.getInteger("jzstd.smallAlphabetSequenceBits", 15));
    /** Sequence cost excluding the offset's own bits. */
    private static final boolean PAIR_PROBE = Boolean.parseBoolean(
            System.getProperty("jzstd.pairProbe", "true"));
    /** Positions probed per batch, with all their loads issued before any comparison. */
    private static final int PROBE_WIDTH =
            Integer.getInteger("jzstd.probeWidth", 4) >= 4 ? 4 : 2;
    private static final int SEQUENCE_BASE_BITS = Math.max(0,
            Integer.getInteger("jzstd.smallAlphabetSequenceBase", 6));

    private static final boolean OPTIMAL_PARSER =
            Boolean.parseBoolean(System.getProperty("jzstd.optimalParser", "true"));
    /**
     * The reference-shaped single-pass forward DP for the ultra tiers
     * (ZSTD_compressBlock_opt_generic): per-position repeat-offset state and exact
     * fractional-bit pricing from persistent statistics replace the backward DP and
     * its feedback/reparse machinery.
     *
     * <p>Off by default: measured better on the dyld-class binary (L19 +2.89% to
     * +0.34%) but worse on the lowercase-words and adaptive corpora (+6.9% and
     * +4.5% vs the reference against +1.4% and -0.5% for the backward DP), which
     * fails the 3% parity guard. The backward path stays the shipped default until
     * the forward parser's candidate pricing closes those gaps.
     */
    private static final boolean FORWARD_OPT_PARSER = Boolean.parseBoolean(
            System.getProperty("jzstd.forwardOptParser", "false"));
    /** ZSTD_OPT_NUM: the forward DP's stretch window. */
    private static final int OPT_NUM = 4096;
    /** ZSTD_MAX_PRICE: bounded so price arithmetic cannot overflow an int. */
    private static final int MAX_PRICE = 1 << 29;
    /** ZSTD_PREDEF_THRESHOLD: tiny blocks price against fixed statistics. */
    private static final int PREDEF_THRESHOLD = 128;
    /** ZSTD_LITFREQ_ADD: how much one observed literal bumps its statistic. */
    private static final int LITFREQ_ADD = 2;
    private static final int OPTIMAL_SEQUENCE_BITS = Math.max(0,
            Integer.getInteger("jzstd.optimalSequenceBits", 6));
    private static final int OPTIMAL_SEQUENCE_EIGHTHS = Math.max(0,
            Integer.getInteger("jzstd.optimalSequenceEighths", 45));
    private static final int OPTIMAL_LOW_ENTROPY_SEQUENCE_EIGHTHS = Math.max(0,
            Integer.getInteger("jzstd.optimalLowEntropySequenceEighths", 80));
    private static final int OPTIMAL_SOURCE_SEQUENCE_EIGHTHS = Math.max(0,

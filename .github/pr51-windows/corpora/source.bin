package dev.jzstd;

import dev.jzstd.internal.BlockCompressor;
import dev.jzstd.internal.CompressionParameters;
import dev.jzstd.internal.DictionaryData;
import dev.jzstd.internal.FrameWriter;
import dev.jzstd.internal.Workspace;
import dev.jzstd.internal.InputBuffer;
import dev.jzstd.internal.ScratchPool;
import dev.jzstd.internal.XxHash64;
import java.util.Arrays;

import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.ExecutionException;
import java.util.concurrent.Executors;
import java.util.concurrent.Future;

/**
 * Public Zstandard API: one-shot helpers and factory entry points.
 */
public final class Jzstd {

    /** Opt-in self-check: decode every produced frame and fail without returning bad output. */
    private static final boolean VERIFY_FRAMES = Boolean.getBoolean("jzstd.verify");
    private static final int MAX_ARRAY_OUTPUT = Integer.MAX_VALUE - 8;
    private static final int DEFAULT_MAX_DECODE_BYTES = (int) Math.max(0,
            Math.min(MAX_ARRAY_OUTPUT,
                    Long.getLong("jzstd.maxDecodeBytes", 1L << 30)));
    private static final long DEFAULT_PARALLEL_MEMORY = Math.min(2L << 30,
            Math.max(64L << 20, Runtime.getRuntime().maxMemory() / 2));
    private static final long PARALLEL_MEMORY_LIMIT = Math.max(64L << 20,
            Long.getLong("jzstd.parallelMemoryBytes", DEFAULT_PARALLEL_MEMORY));
    private static final int PARALLEL_TREE_RESEED_STEP = Math.max(1,
            Integer.getInteger("jzstd.treeReseedStep", 256));
    private static final int PARALLEL_FAST_RESEED_STEP = Math.max(1,
            Integer.getInteger("jzstd.parallelFastReseedStep", 32));

    private Jzstd() {}

    /** Releases all currently idle codec scratch and invalidates outstanding pool leases. */
    public static void releaseCachedResources() {
        ScratchPool.clear();
    }

    /**
     * Compresses {@code src} into a newly allocated array at one of the levels
     * returned by {@link Zstd#supportedCompressionLevels()}.
     */
    public static byte[] compress(byte[] src, int level) {
        java.util.Objects.requireNonNull(src, "src");
        return compress(src, 0, src.length, level, true);
    }

    public static byte[] compress(byte[] src, int level, boolean checksum) {
        java.util.Objects.requireNonNull(src, "src");
        return compress(src, 0, src.length, level, checksum);
    }

    /** Compresses with an optional explicit wlog 27..31 long-distance match window. */
    public static byte[] compress(byte[] src, ZstdCompressionOptions options) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(options, "options");
        byte[] dst = new byte[compressBound(src.length)];
        int written = compress(src, 0, src.length, dst, 0, dst.length, options);
        return Arrays.copyOf(dst, written);
    }

    /** Caller-owned destination form of {@link #compress(byte[], ZstdCompressionOptions)}. */
    public static int compress(byte[] src, int srcOff, int srcLen,
                               byte[] dst, int dstOff, int dstMax,
                               ZstdCompressionOptions options) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        java.util.Objects.requireNonNull(options, "options");
        java.util.Objects.checkFromIndexSize(srcOff, srcLen, src.length);
        java.util.Objects.checkFromIndexSize(dstOff, dstMax, dst.length);
        requireNonOverlapping(src, srcOff, srcLen, dst, dstOff, dstMax);
        int required = compressBound(srcLen);
        if (dstMax < required) {
            throw new ZstdException(ZstdException.DESTINATION_TOO_SMALL,
                    "Destination requires at least " + required + " bytes");
        }
        CompressionParameters params = CompressionParameters.get(options.level(), srcLen);
        if (options.windowLog() != 0) params = params.withWindowLog(options.windowLog());
        boolean singleSegment = options.windowLog() == 0 && fitsSingleSegment(srcLen, params);
        return compressWithParameters(src, srcOff, srcLen, dst, dstOff,
                options.checksum(), params, singleSegment);
    }

    /** Compresses using raw or formatted dictionary history. */
    public static byte[] compress(byte[] src, int level, ZstdDictionary dictionary) {
        java.util.Objects.requireNonNull(src, "src");
        return compress(src, 0, src.length, level, true, dictionary);
    }

    /** Compresses with a reusable level-specific dictionary handle. */
    public static byte[] compress(byte[] src, ZstdPreparedDictionary dictionary) {
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return compress(src, dictionary.compressionLevel(), dictionary.dictionary());
    }

    /** Compresses a source range using raw or formatted dictionary history. */
    public static byte[] compress(byte[] src, int off, int len, int level,
                                  boolean checksum, ZstdDictionary dictionary) {
        java.util.Objects.requireNonNull(src, "src");
        Zstd.requireSupportedCompressionLevel(level);
        byte[] dst = new byte[compressBound(len)];
        int written = compress(src, off, len, dst, 0, dst.length,
                level, checksum, dictionary);
        return Arrays.copyOf(dst, written);
    }

    public static byte[] compress(byte[] src, int off, int len, int level, boolean checksum) {
        java.util.Objects.requireNonNull(src, "src");
        Zstd.requireSupportedCompressionLevel(level);
        byte[] dst = new byte[compressBound(len)];
        int written = compress(src, off, len, dst, 0, dst.length, level, checksum);
        return Arrays.copyOf(dst, written);
    }

    /**
     * Whether the whole content fits the frame window, letting the header omit its
     * window descriptor and, below 256 bytes, use a one-byte content size. Saves one
     * to four bytes per frame relative to always declaring an explicit window.
     */
    private static boolean fitsSingleSegment(int contentSize, CompressionParameters params) {
        return contentSize >= 0 && contentSize <= params.windowSize();
    }

    /**
     * Maximum destination size required by {@link #compress(byte[], int, int, byte[], int, int, int, boolean)}.
     */
    public static int compressBound(int sourceSize) {
        if (sourceSize < 0) throw new IllegalArgumentException("negative source size");
        long bound = (long) sourceSize + (sourceSize >>> 7) + 128;
        if (bound > Integer.MAX_VALUE - 8L) {
            throw new IllegalArgumentException("source is too large for a Java array");
        }
        return (int) bound;
    }

    /**
     * Compresses into caller-owned storage and returns the number of bytes written.
     * Reusing {@code dst} avoids the allocation and final copy performed by the
     * convenience methods.
     */
    public static int compress(byte[] src, int srcOff, int srcLen,
                               byte[] dst, int dstOff, int dstMax,
                               int level, boolean checksum) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        Zstd.requireSupportedCompressionLevel(level);
        java.util.Objects.checkFromIndexSize(srcOff, srcLen, src.length);
        java.util.Objects.checkFromIndexSize(dstOff, dstMax, dst.length);
        requireNonOverlapping(src, srcOff, srcLen, dst, dstOff, dstMax);
        int required = compressBound(srcLen);
        if (dstMax < required) {
            throw new ZstdException(ZstdException.DESTINATION_TOO_SMALL,
                    "Destination requires at least " + required + " bytes");
        }

        CompressionParameters params = CompressionParameters.get(level, srcLen);
        return compressWithParameters(src, srcOff, srcLen, dst, dstOff,
                checksum, params, fitsSingleSegment(srcLen, params));
    }

    private static int compressWithParameters(byte[] src, int srcOff, int srcLen,
                                              byte[] dst, int dstOff,
                                              boolean checksum,
                                              CompressionParameters params,
                                              boolean singleSegment) {
        int len = srcLen;
        int off = srcOff;
        long leaseEpoch = ScratchPool.epoch();
        Workspace ws = ScratchPool.acquireWorkspace();
        try {
            ws.resetCompression(params);

        int p = dstOff + FrameWriter.writeFrameHeader(dst, dstOff, len,
                Math.max(params.windowLog, Zstd.MIN_WINDOW_LOG), checksum,
                singleSegment);

        int blockSize = params.blockSize();
        int pos = off;
        final int end = off + len;
        int[] rep = ws.repOffsets;
        // Hash each block as it is consumed rather than making a second pass over the
        // whole source; checksums are on by default, so that pass was on the hot path.
        XxHash64 hasher = ws.contentHasher;
        if (checksum) hasher.reset(0L);
        if (len == 0) {
            // A frame must contain at least one block.
            p += FrameWriter.writeRawBlock(dst, p, src, 0, 0, true);
        }
        while (pos < end) {
            int take = BlockCompressor.selectBlockSize(ws, src, pos,
                    end - pos, blockSize, params, pos == off);
            boolean last = pos + take >= end;
            if (checksum) hasher.update(src, pos, take);
            int produced = BlockCompressor.compressBlock(ws, src, pos, take,
                    dst, p, rep, Math.max(off, pos - params.windowSize()),
                    end, len, params, last);
            if (produced < 0) {
                produced = FrameWriter.writeRawBlock(dst, p, src, pos, take, last);
            }
            ws.splitSavings += take - produced;
            p += produced;
            pos += take;
        }

        if (checksum) {
            long h = hasher.getValue() & 0xFFFFFFFFL;
            dst[p++] = (byte) h;
            dst[p++] = (byte) (h >> 8);
            dst[p++] = (byte) (h >> 16);
            dst[p++] = (byte) (h >> 24);
        }

        // Full-frame verification: decode our own output and compare
        int written = p - dstOff;
        if (VERIFY_FRAMES && len > 0
                && !verifyFrame(dst, dstOff, written, src, off, len, checksum)) {
            throw new ZstdException(ZstdException.GENERIC,
                    "Encoder verification failed; no frame was returned");
        }
            return written;
        } finally {
            ScratchPool.releaseWorkspace(ws, leaseEpoch);
        }
    }

    /**
     * Compresses into caller-owned storage using dictionary content as virtual
     * history preceding {@code srcOff}. Dictionary bytes are never emitted.
     */
    public static int compress(byte[] src, int srcOff, int srcLen,
                               byte[] dst, int dstOff, int dstMax,
                               int level, boolean checksum, ZstdDictionary dictionary) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        Zstd.requireSupportedCompressionLevel(level);
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        java.util.Objects.checkFromIndexSize(srcOff, srcLen, src.length);
        java.util.Objects.checkFromIndexSize(dstOff, dstMax, dst.length);
        requireNonOverlapping(src, srcOff, srcLen, dst, dstOff, dstMax);
        int required = compressBound(srcLen);
        if (dstMax < required) {
            throw new ZstdException(ZstdException.DESTINATION_TOO_SMALL,
                    "Destination requires at least " + required + " bytes");
        }

        CompressionParameters params = CompressionParameters.get(level, srcLen);
        DictionaryData dictionaryData = dictionary.data();
        int dictionaryLength = Math.min(dictionaryData.content.length, params.windowSize());
        if (srcLen > Integer.MAX_VALUE - dictionaryLength) {
            throw new IllegalArgumentException("dictionary plus source is too large");
        }
        long leaseEpoch = ScratchPool.epoch();
        Workspace ws = ScratchPool.acquireWorkspace();
        try {
        byte[] input = ws.ensureDictionaryInput(dictionaryLength + srcLen);
        System.arraycopy(dictionaryData.content,
                dictionaryData.content.length - dictionaryLength,
                input, 0, dictionaryLength);
        System.arraycopy(src, srcOff, input, dictionaryLength, srcLen);

        ws.resetCompression(params);
        ws.seedCompressionDictionary(0, dictionaryLength);
        int[] rep = ws.repOffsets;
        if (dictionaryData.rep != null) {
            System.arraycopy(dictionaryData.rep, 0, rep, 0, rep.length);
        }
        XxHash64 hasher = ws.contentHasher;
        if (checksum) hasher.reset(0L);

        int p = dstOff + FrameWriter.writeFrameHeader(dst, dstOff, srcLen,
                Math.max(params.windowLog, Zstd.MIN_WINDOW_LOG), checksum,
                fitsSingleSegment(srcLen, params), dictionaryData.id);
        int blockSize = params.blockSize();
        int pos = dictionaryLength;
        int end = dictionaryLength + srcLen;
        if (srcLen == 0) {
            p += FrameWriter.writeRawBlock(dst, p, input, dictionaryLength, 0, true);
        }
        while (pos < end) {
            int take = BlockCompressor.selectBlockSize(ws, input, pos,
                    end - pos, blockSize, params, pos == dictionaryLength);
            boolean last = pos + take >= end;
            if (checksum) hasher.update(input, pos, take);
            int produced = BlockCompressor.compressBlock(ws, input, pos, take,
                    dst, p, rep, Math.max(0, pos - params.windowSize()),
                    end, srcLen, params, last);
            if (produced < 0) {
                produced = FrameWriter.writeRawBlock(dst, p, input, pos, take, last);
            }
            ws.splitSavings += take - produced;
            p += produced;
            pos += take;
        }

        if (checksum) {
            long hash = hasher.getValue() & 0xFFFFFFFFL;
            dst[p++] = (byte) hash;
            dst[p++] = (byte) (hash >> 8);
            dst[p++] = (byte) (hash >> 16);
            dst[p++] = (byte) (hash >> 24);
        }
        return p - dstOff;
        } finally {
            ScratchPool.releaseWorkspace(ws, leaseEpoch);
        }
    }

    /** Compresses at the default level. */
    public static byte[] compress(byte[] src) {
        return compress(src, Zstd.DEFAULT_COMPRESSION_LEVEL);
    }

    /**
     * Compresses one frame using the standard zstd header with its four-byte magic
     * omitted. The caller/container must carry the format out of band.
     */
    public static byte[] compressMagicless(byte[] src, int level) {
        java.util.Objects.requireNonNull(src, "src");
        byte[] standard = compress(src, level);
        return Arrays.copyOfRange(standard, Integer.BYTES, standard.length);
    }

    /**
     * Compresses ordered block ranges on virtual threads and assembles one frame.
     * Jobs retain the preceding window as read-only match history.
     */
    public static byte[] compressParallel(byte[] src, int level, int parallelism) {
        return compressParallel(src, level, parallelism, true, null);
    }

    /** Parallel compression with explicit checksum selection. */
    public static byte[] compressParallel(byte[] src, int level, int parallelism,
                                          boolean checksum) {
        return compressParallel(src, level, parallelism, checksum, null);
    }

    /** Parallel single-frame compression with block jobs executed on virtual threads. */
    public static byte[] compressParallel(byte[] src, int level, int parallelism,
                                          boolean checksum, ZstdDictionary dictionary) {
        java.util.Objects.requireNonNull(src, "src");
        Zstd.requireSupportedCompressionLevel(level);
        if (parallelism <= 0) throw new IllegalArgumentException("parallelism must be positive");
        if (src.length == 0 || parallelism == 1) {
            return dictionary == null ? compress(src, level, checksum)
                    : compress(src, 0, src.length, level, checksum, dictionary);
        }
        int oneMiBJobs = (int) (((long) src.length + (1 << 20) - 1) >>> 20);
        CompressionParameters params = CompressionParameters.get(level, src.length);
        int blocks = (src.length + params.blockSize() - 1) / params.blockSize();
        int jobs = Math.min(Math.min(parallelism, Math.max(1, oneMiBJobs)), blocks);
        long workspaceBytes = estimatedParallelWorkspaceBytes(params);
        int memoryJobs = (int) Math.max(1, Math.min(Integer.MAX_VALUE,
                PARALLEL_MEMORY_LIMIT / Math.max(1, workspaceBytes)));
        jobs = Math.min(jobs, memoryJobs);
        if (jobs == 1) {
            return dictionary == null ? compress(src, level, checksum)
                    : compress(src, 0, src.length, level, checksum, dictionary);
        }

        DictionaryData dictionaryData = dictionary == null ? null : dictionary.data();
        int dictionaryLength = dictionaryData == null ? 0
                : Math.min(dictionaryData.content.length, params.windowSize());
        byte[] input;
        int contentStart;
        if (dictionaryLength == 0) {
            input = src;
            contentStart = 0;
        } else {
            if (src.length > Integer.MAX_VALUE - dictionaryLength) {
                throw new IllegalArgumentException("dictionary plus source is too large");
            }
            input = new byte[dictionaryLength + src.length];
            System.arraycopy(dictionaryData.content,
                    dictionaryData.content.length - dictionaryLength,
                    input, 0, dictionaryLength);
            System.arraycopy(src, 0, input, dictionaryLength, src.length);
            contentStart = dictionaryLength;
        }

        List<Future<CompressedJob>> futures = new ArrayList<>(jobs);
        boolean[] completed = {false};
        try (var executor = Executors.newVirtualThreadPerTaskExecutor()) {
            try {
                for (int job = 0; job < jobs; job++) {
                    int firstBlock = job * blocks / jobs;
                    int afterLastBlock = (job + 1) * blocks / jobs;
                    int jobStart = contentStart + firstBlock * params.blockSize();
                    int jobEnd = contentStart + Math.min(src.length,
                            afterLastBlock * params.blockSize());
                    boolean firstJob = job == 0;
                    futures.add(executor.submit(() -> compressParallelJob(input,
                            jobStart, jobEnd, contentStart, src.length, params,
                            dictionaryData, firstJob)));
                }

                List<CompressedJob> results = new ArrayList<>(jobs);
                long blockBytes = 0;
                for (Future<CompressedJob> future : futures) {
                    CompressedJob result = future.get();
                    results.add(result);
                    blockBytes += result.length;
                }

            byte[] header = new byte[32];
            int headerSize = FrameWriter.writeFrameHeader(header, 0, src.length,
                    Math.max(params.windowLog, Zstd.MIN_WINDOW_LOG), checksum,
                    fitsSingleSegment(src.length, params),
                    dictionaryData == null ? 0 : dictionaryData.id);
            long total = headerSize + blockBytes + (checksum ? 4L : 0L);
            if (total > MAX_ARRAY_OUTPUT) {
                throw new IllegalArgumentException("compressed frame is too large");
            }
            byte[] output = new byte[(int) total];
            System.arraycopy(header, 0, output, 0, headerSize);
            int position = headerSize;
            int finalHeader = -1;
            for (CompressedJob result : results) {
                System.arraycopy(result.blocks, 0, output, position, result.length);
                finalHeader = position + result.lastBlockHeader;
                position += result.length;
            }
            output[finalHeader] |= 1;
            if (checksum) {
                long hash = XxHash64.hash(src, 0, src.length, 0L);
                output[position++] = (byte) hash;
                output[position++] = (byte) (hash >>> 8);
                output[position++] = (byte) (hash >>> 16);
                output[position++] = (byte) (hash >>> 24);
            }
                completed[0] = true;
                return output;
            } finally {
                if (!completed[0]) {
                    for (Future<CompressedJob> future : futures) {
                        future.cancel(true);
                    }
                }
            }
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            throw new ZstdException(ZstdException.GENERIC, "Parallel compression interrupted", e);
        } catch (ExecutionException e) {
            Throwable cause = e.getCause();
            if (cause instanceof Error error) throw error;
            if (cause instanceof ZstdException zstd) throw zstd;
            if (cause instanceof RuntimeException runtime) {
                throw new ZstdException(ZstdException.GENERIC,
                        "Parallel compression failed", runtime);
            }
            throw new ZstdException(ZstdException.GENERIC, "Parallel compression failed", cause);
        }
    }

    private static CompressedJob compressParallelJob(byte[] input,
                                                     int start, int end,
                                                     int contentStart, int contentSize,
                                                     CompressionParameters params,
                                                     DictionaryData dictionary,
                                                     boolean firstJob) {
        long leaseEpoch = ScratchPool.epoch();
        Workspace workspace = ScratchPool.acquireWorkspace();
        try {
            workspace.resetCompression(params);
            workspace.forceExplicitOffsets = !firstJob;
            if (firstJob && dictionary != null && dictionary.rep != null) {
                System.arraycopy(dictionary.rep, 0, workspace.repOffsets, 0, 3);
            }
            int historyStart = Math.max(0, start - params.windowSize());
            if (start > historyStart) {
                workspace.seedCompressionDictionary(historyStart, start,
                        !firstJob ? params.usesSuffixTree()
                                ? PARALLEL_TREE_RESEED_STEP
                                : PARALLEL_FAST_RESEED_STEP : 1);
            }

            byte[] output = new byte[compressBound(end - start)];
            int written = 0;
            int lastHeader = -1;
            int position = start;
            while (position < end) {
                int available = end - position;
                int take = Math.min(available, BlockCompressor.selectBlockSize(workspace,
                        input, position, available, params.blockSize(), params,
                        position == start));
                lastHeader = written;
                int produced = BlockCompressor.compressBlock(workspace,
                        input, position, take, output, written, workspace.repOffsets,
                        Math.max(0, position - params.windowSize()), input.length,
                        contentSize, params, false);
                if (produced < 0) {
                    produced = FrameWriter.writeRawBlock(output, written,
                            input, position, take, false);
                }
                workspace.splitSavings += take - produced;
                written += produced;
                position += take;
            }
            // Keep the oversize job buffer and its logical length. Final assembly already
            // has to copy each job into the contiguous frame; trimming here merely copied
            // every compressed byte an additional time and allocated another array.
            return new CompressedJob(output, written, lastHeader);
        } finally {
            ScratchPool.releaseWorkspace(workspace, leaseEpoch);
        }
    }

    private static long estimatedParallelWorkspaceBytes(CompressionParameters params) {
        long hashEntries = 1L << Math.max(6, params.hashLog);
        long total = 8L << 20;
        if (params.strategy >= CompressionParameters.STRATEGY_BTLAZY2) {
            long chainEntries = 1L << Math.max(6, params.chainLog);
            total += (params.usesSuffixTree() ? 16L : 4L) * chainEntries;
            total += (params.hashLog > 20 ? 8L : 4L) * hashEntries;
            if (params.usesSuffixTree()) total += 64L * params.blockSize();
        } else {
            total += 8L * hashEntries;
        }
        return total;
    }

    private record CompressedJob(byte[] blocks, int length, int lastBlockHeader) {}

    /** Parallel compression using a prepared dictionary's bound level. */
    public static byte[] compressParallel(byte[] src, ZstdPreparedDictionary dictionary,
                                          int parallelism, boolean checksum) {
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return compressParallel(src, dictionary.compressionLevel(), parallelism,
                checksum, dictionary.dictionary());
    }

    /**
     * Decompresses a complete zstd frame stream into a new array.
     *
     * @throws ZstdException on malformed input
     */
    public static byte[] decompress(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        return decompress(src, 0, src.length,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG);
    }

    /** Decompresses with an explicit maximum accepted window log. */
    public static byte[] decompress(byte[] src, int maxWindowLog) {
        java.util.Objects.requireNonNull(src, "src");
        return decompress(src, 0, src.length, maxWindowLog);
    }

    /** Decompresses a complete frame stream using raw or formatted dictionary history. */
    public static byte[] decompress(byte[] src, ZstdDictionary dictionary) {
        java.util.Objects.requireNonNull(src, "src");
        return decompress(src, dictionary,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG);
    }

    /** Decompresses with dictionary history and an explicit window cap. */
    public static byte[] decompress(byte[] src, ZstdDictionary dictionary, int maxWindowLog) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return decompressToNew(src, 0, src.length, dictionary.data(), maxWindowLog,
                DEFAULT_MAX_DECODE_BYTES);
    }

    /**
     * Decompresses into a new array while enforcing an output limit. This overload is
     * intended for inputs whose trustworthiness or declared content size is unknown.
     */
    public static byte[] decompressBounded(byte[] src, int maxWindowLog,
                                           int maxOutputSize) {
        java.util.Objects.requireNonNull(src, "src");
        return decompressToNew(src, 0, src.length, null, maxWindowLog, maxOutputSize);
    }

    /** Bounded allocating decompression using the default window cap. */
    public static byte[] decompressBounded(byte[] src, int maxOutputSize) {
        return decompressBounded(src,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG, maxOutputSize);
    }

    /** Bounded allocating decompression with raw or formatted dictionary history. */
    public static byte[] decompressBounded(byte[] src, ZstdDictionary dictionary,
                                           int maxWindowLog, int maxOutputSize) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return decompressToNew(src, 0, src.length, dictionary.data(), maxWindowLog,
                maxOutputSize);
    }

    /** Decodes one magicless frame using the default window and array-output limits. */
    public static byte[] decompressMagicless(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        return decompressMagiclessToNew(src, null,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG,
                DEFAULT_MAX_DECODE_BYTES);
    }

    /** Decodes one magicless frame while enforcing window and output limits. */
    public static byte[] decompressMagiclessBounded(byte[] src, int maxWindowLog,
                                                     int maxOutputSize) {
        java.util.Objects.requireNonNull(src, "src");
        return decompressMagiclessToNew(src, null, maxWindowLog, maxOutputSize);
    }

    /** Decodes one magicless frame with dictionary history. */
    public static byte[] decompressMagicless(byte[] src, ZstdDictionary dictionary) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return decompressMagiclessToNew(src, dictionary.data(),
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG,
                DEFAULT_MAX_DECODE_BYTES);
    }

    public static byte[] decompress(byte[] src, int offset, int length) {
        return decompress(src, offset, length,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG);
    }

    /** Decompresses a source range with an explicit maximum accepted window log. */
    public static byte[] decompress(byte[] src, int offset, int length, int maxWindowLog) {
        return decompressToNew(src, offset, length, null, maxWindowLog,
                DEFAULT_MAX_DECODE_BYTES);
    }

    /** Bounded allocating decompression of a source range. */
    public static byte[] decompressBounded(byte[] src, int offset, int length,
                                           int maxWindowLog, int maxOutputSize) {
        return decompressToNew(src, offset, length, null, maxWindowLog, maxOutputSize);
    }

    private static byte[] decompressToNew(byte[] src, int offset, int length,
                                          DictionaryData dictionary, int maxWindowLog,
                                          int maxOutputSize) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.checkFromIndexSize(offset, length, src.length);
        if (maxOutputSize < 0 || maxOutputSize > MAX_ARRAY_OUTPUT) {
            throw new IllegalArgumentException("maxOutputSize must be in [0, "
                    + MAX_ARRAY_OUTPUT + "]");
        }
        try {
            long known = findDecompressedSize(src, offset, length);
            if (known > maxOutputSize) {
                throw outputLimitExceeded(known, maxOutputSize);
            }
            if (known >= 0) {
                int exactSize = Math.toIntExact(known);
                byte[] output = new byte[exactSize];
                int written;
                if (dictionary == null) {
                    written = decodeAllToArray(src, offset, length, output, 0,
                            exactSize, maxWindowLog, false);
                } else {
                    Sink sink = new Sink(output, 0, exactSize);
                    decodeAll(src, offset, length, sink, dictionary, maxWindowLog,
                            exactSize);
                    written = sink.count;
                }
                if (written != exactSize) {
                    throw new ZstdException(ZstdException.CORRUPTION_DETECTED,
                            "Frame content size mismatch");
                }
                return output;
            }
            BoundedByteArrayOutput output = new BoundedByteArrayOutput(maxOutputSize);
            decodeAll(src, offset, length, output, dictionary, maxWindowLog,
                    maxOutputSize);
            return output.toByteArray();
        } catch (IOException e) {
            throw decompressionFailure(e);
        }
    }

    private static byte[] decompressMagiclessToNew(byte[] src, DictionaryData dictionary,
                                                    int maxWindowLog, int maxOutputSize) {
        if (maxOutputSize < 0 || maxOutputSize > MAX_ARRAY_OUTPUT) {
            throw new IllegalArgumentException("maxOutputSize must be in [0, "
                    + MAX_ARRAY_OUTPUT + "]");
        }
        try {
            BoundedByteArrayOutput output = new BoundedByteArrayOutput(maxOutputSize);
            decodeAll(src, 0, src.length, output, dictionary, maxWindowLog,
                    maxOutputSize, true);
            return output.toByteArray();
        } catch (IOException e) {
            throw decompressionFailure(e);
        }
    }

    private static ZstdException outputLimitExceeded(long required, int limit) {
        return new ZstdException(ZstdException.DESTINATION_TOO_SMALL,
                "Decompressed output exceeds maxOutputSize " + limit
                        + (required >= 0 ? ": " + required : ""));
    }

    /**
     * Decompresses into the provided array.
     *
     * @return number of bytes written
     */
    public static int decompress(byte[] src, byte[] dst) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        return decompress(src, 0, src.length, dst, 0, dst.length);
    }

    /** Decodes one magicless frame into caller-owned storage. */
    public static int decompressMagicless(byte[] src, byte[] dst) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        requireNonOverlapping(src, 0, src.length, dst, 0, dst.length);
        try {
            return decodeAllToArray(src, 0, src.length, dst, 0, dst.length,
                    dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG, true);
        } catch (IOException e) {
            throw decompressionFailure(e);
        }
    }

    /** Decompresses into caller storage with an explicit window cap. */
    public static int decompress(byte[] src, byte[] dst, int maxWindowLog) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        return decompress(src, 0, src.length, dst, 0, dst.length, maxWindowLog);
    }

    /** Decompresses into caller-owned storage using dictionary history. */
    public static int decompress(byte[] src, byte[] dst, ZstdDictionary dictionary) {
        return decompress(src, dst, dictionary,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG);
    }

    /** Decompresses into caller storage using dictionary history and a window cap. */
    public static int decompress(byte[] src, byte[] dst, ZstdDictionary dictionary,
                                 int maxWindowLog) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return decompressToSink(src, 0, src.length, dst, 0, dst.length,
                dictionary.data(), maxWindowLog);
    }

    public static int decompress(byte[] src, int srcOff, int srcLen,
                                 byte[] dst, int dstOff, int dstMax) {
        return decompress(src, srcOff, srcLen, dst, dstOff, dstMax,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG);
    }

    /** Decompresses a source range into a destination range with a window cap. */
    public static int decompress(byte[] src, int srcOff, int srcLen,
                                 byte[] dst, int dstOff, int dstMax, int maxWindowLog) {
        return decompressToSink(src, srcOff, srcLen, dst, dstOff, dstMax,
                null, maxWindowLog);
    }

    /** Decompresses ranges using dictionary history and a window cap. */
    public static int decompress(byte[] src, int srcOff, int srcLen,
                                 byte[] dst, int dstOff, int dstMax,
                                 ZstdDictionary dictionary, int maxWindowLog) {
        java.util.Objects.requireNonNull(dictionary, "dictionary");
        return decompressToSink(src, srcOff, srcLen, dst, dstOff, dstMax,
                dictionary.data(), maxWindowLog);
    }

    private static int decompressToSink(byte[] src, int srcOff, int srcLen,
                                        byte[] dst, int dstOff, int dstMax,
                                        DictionaryData dictionary, int maxWindowLog) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.requireNonNull(dst, "dst");
        java.util.Objects.checkFromIndexSize(srcOff, srcLen, src.length);
        java.util.Objects.checkFromIndexSize(dstOff, dstMax, dst.length);
        requireNonOverlapping(src, srcOff, srcLen, dst, dstOff, dstMax);
        try {
            if (dictionary == null) {
                return decodeAllToArray(src, srcOff, srcLen, dst, dstOff, dstMax,
                        maxWindowLog, false);
            }
            Sink sink = new Sink(dst, dstOff, dstMax);
            decodeAll(src, srcOff, srcLen, sink, dictionary, maxWindowLog, dstMax);
            return sink.count;
        } catch (IOException e) {
            throw decompressionFailure(e);
        }
    }

    private static int decodeAllToArray(byte[] src, int offset, int length,
                                        byte[] dst, int dstOff, int dstMax,
                                        int maxWindowLog, boolean magicless) throws IOException {
        InputBuffer in = new InputBuffer(src, offset, length);
        long leaseEpoch = ScratchPool.epoch();
        dev.jzstd.internal.FrameDecoder decoder = ScratchPool.acquireDecoder();
        try {
            decoder.setDictionary(null);
            decoder.setMagicless(magicless);
            decoder.setMaxWindowLog(maxWindowLog);
            decoder.setMaxOutputSize(dstMax);
            decoder.setDirectOutput(dst, dstOff, dstMax);
            decoder.resetStream();
            OutputStream sink = OutputStream.nullOutputStream();
            while (decoder.advance(in)) decoder.drainTo(sink);
            decoder.drainTo(sink);
            return Math.toIntExact(decoder.producedBytes());
        } finally {
            ScratchPool.releaseDecoder(decoder, leaseEpoch);
        }
    }

    private static void decodeAll(byte[] src, int offset, int length, OutputStream sink) throws IOException {
        decodeAll(src, offset, length, sink, null,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG,
                MAX_ARRAY_OUTPUT);
    }

    private static void decodeAll(byte[] src, int offset, int length, OutputStream sink,
                                  DictionaryData dictionary) throws IOException {
        decodeAll(src, offset, length, sink, dictionary,
                dev.jzstd.internal.FrameDecoder.DEFAULT_MAX_WINDOW_LOG,
                MAX_ARRAY_OUTPUT);
    }

    private static void decodeAll(byte[] src, int offset, int length, OutputStream sink,
                                  DictionaryData dictionary, int maxWindowLog,
                                  long maxOutputSize) throws IOException {
        decodeAll(src, offset, length, sink, dictionary, maxWindowLog,
                maxOutputSize, false);
    }

    private static void decodeAll(byte[] src, int offset, int length, OutputStream sink,
                                  DictionaryData dictionary, int maxWindowLog,
                                  long maxOutputSize, boolean magicless) throws IOException {
        InputBuffer in = new InputBuffer(src, offset, length);
        long leaseEpoch = ScratchPool.epoch();
        dev.jzstd.internal.FrameDecoder decoder = ScratchPool.acquireDecoder();
        try {
            decoder.setDictionary(dictionary);
            decoder.setMagicless(magicless);
            decoder.setMaxWindowLog(maxWindowLog);
            decoder.setMaxOutputSize(maxOutputSize);
            decoder.resetStream();
            while (decoder.advance(in)) decoder.drainTo(sink);
            decoder.drainTo(sink);
        } finally {
            ScratchPool.releaseDecoder(decoder, leaseEpoch);
        }
    }

    /** Growable output that checks the caller's limit before allocating or copying. */
    private static final class BoundedByteArrayOutput extends OutputStream {
        private final int max;
        private byte[] buffer;
        private int count;

        BoundedByteArrayOutput(int max) {
            this.max = max;
            this.buffer = new byte[Math.min(max, 1 << 16)];
        }

        @Override
        public void write(int value) {
            requireRoom(1);
            ensureCapacity(count + 1);
            buffer[count++] = (byte) value;
        }

        @Override
        public void write(byte[] source, int offset, int length) {
            java.util.Objects.checkFromIndexSize(offset, length, source.length);
            requireRoom(length);
            ensureCapacity(count + length);
            System.arraycopy(source, offset, buffer, count, length);
            count += length;
        }

        byte[] toByteArray() {
            return count == buffer.length ? buffer : Arrays.copyOf(buffer, count);
        }

        int size() {
            return count;
        }

        private void requireRoom(int length) {
            if (length > max - count) throw outputLimitExceeded(-1, max);
        }

        private void ensureCapacity(int required) {
            if (required <= buffer.length) return;
            long doubled = Math.max(1L << 16, (long) buffer.length * 2);
            int capacity = (int) Math.min(max, Math.max(required, doubled));
            buffer = Arrays.copyOf(buffer, capacity);
        }
    }

    private static void requireNonOverlapping(byte[] src, int srcOff, int srcLen,
                                              byte[] dst, int dstOff, int dstLen) {
        if (src != dst) return;
        long srcEnd = (long) srcOff + srcLen;
        long dstEnd = (long) dstOff + dstLen;
        if (srcOff < dstEnd && dstOff < srcEnd) {
            throw new IllegalArgumentException("source and destination ranges overlap");
        }
    }

    /** OutputStream writing into a fixed range of an array. */
    private static final class Sink extends OutputStream {
        private final byte[] a;
        private final int off;
        private final int max;
        private int count;

        Sink(byte[] a, int off, int max) {
            this.a = a;
            this.off = off;
            this.max = max;
        }

        @Override
        public void write(int b) throws IOException {
            if (count >= max) {
                throw new ZstdException(ZstdException.DESTINATION_TOO_SMALL,
                        "Destination too small");
            }
            a[off + count++] = (byte) b;
        }

        @Override
        public void write(byte[] b, int o, int len) throws IOException {
            if (len > max - count) {
                throw new ZstdException(ZstdException.DESTINATION_TOO_SMALL,
                        "Destination too small");
            }
            System.arraycopy(b, o, a, off + count, len);
            count += len;
        }
    }

    /** Creates a streaming decoder over the given source. */
    public static ZstdInputStream newInputStream(InputStream in) {
        return new ZstdInputStream(in);
    }

    /** Kind of frame recognized by {@link #getFrameInfo(byte[])}. */
    public enum FrameType { STANDARD, SKIPPABLE }

    /** Metadata shared by standard and skippable frames. */
    public sealed interface FrameInfo permits FrameHeader, SkippableFrameHeader {
        FrameType type();
        int headerSize();
    }

    /**
     * Parsed fields from a standard Zstandard frame header.
     *
     * @param contentSize decoded size, or -1 when absent
     * @param dictionaryId unsigned dictionary ID, or zero when absent
     * @param windowSize declared match window
     * @param checksum whether a content checksum follows the final block
     * @param singleSegment whether the frame uses single-segment framing
     * @param headerSize complete frame-header size including magic
     */
    public record FrameHeader(long contentSize, long dictionaryId, long windowSize,
                              boolean checksum, boolean singleSegment, int headerSize)
            implements FrameInfo {
        @Override
        public FrameType type() {
            return FrameType.STANDARD;
        }
    }

    /**
     * Parsed fields from a skippable frame header.
     *
     * @param variant skippable magic variant in [0, 15]
     * @param payloadSize unsigned 32-bit payload size
     * @param headerSize header size (always eight bytes)
     */
    public record SkippableFrameHeader(int variant, long payloadSize, int headerSize)
            implements FrameInfo {
        @Override
        public FrameType type() {
            return FrameType.SKIPPABLE;
        }
    }

    /**
     * Location and metadata of one frame in a concatenated byte-array stream.
     *
     * @param offset absolute byte offset in the scanned source array
     * @param compressedSize complete frame size including header and checksum
     * @param info parsed standard or skippable frame metadata
     */
    public record FrameSpan(int offset, int compressedSize, FrameInfo info) {}

    /** Returns whether the input starts with a standard or skippable Zstandard frame. */
    public static boolean isFrame(byte[] src) {
        if (src == null || src.length < 4) return false;
        int magic = intLE(src, 0);
        return magic == Zstd.MAGIC_NUMBER
                || magic >= Zstd.SKIPPABLE_MAGIC_MIN && magic <= Zstd.SKIPPABLE_MAGIC_MAX;
    }

    /** Returns the first standard frame's declared content size, or {@code -1} if unknown. */
    public static long getFrameContentSize(byte[] src) {
        return getFrameHeader(src).contentSize();
    }

    /** Returns the first standard frame's unsigned dictionary ID, or zero when absent. */
    public static long getDictionaryId(byte[] src) {
        return getFrameHeader(src).dictionaryId();
    }

    /** Parses the first standard frame header without decompressing its blocks. */
    public static FrameHeader getFrameHeader(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        FrameInfo info = getFrameInfo(src);
        if (info instanceof FrameHeader header) return header;
        throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                "Input starts with a skippable frame, not a standard frame");
    }

    /** Parses either a standard or skippable frame header without consuming its payload. */
    public static FrameInfo getFrameInfo(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        if (src.length < 4) throw truncatedMetadata("Truncated frame magic");
        int magic = intLE(src, 0);
        if (magic >= Zstd.SKIPPABLE_MAGIC_MIN && magic <= Zstd.SKIPPABLE_MAGIC_MAX) {
            if (src.length < 8) throw truncatedMetadata("Truncated skippable frame header");
            return new SkippableFrameHeader(magic - Zstd.SKIPPABLE_MAGIC_MIN,
                    intLE(src, 4) & 0xFFFFFFFFL, 8);
        }
        if (magic != Zstd.MAGIC_NUMBER) {
            throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                    "Unknown frame magic: " + Integer.toHexString(magic));
        }
        return parseFrameHeader(src, 0, src.length);
    }

    /** Returns the encoded size of the first standard or skippable frame. */
    public static int findFrameCompressedSize(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        return findFrameCompressedSize(src, 0, src.length);
    }

    /** Range form of {@link #findFrameCompressedSize(byte[])}. */
    public static int findFrameCompressedSize(byte[] src, int offset, int length) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.checkFromIndexSize(offset, length, src.length);
        if (length == 0) throw truncatedMetadata("Empty frame stream");
        return scanFrameEnd(src, offset, offset + length) - offset;
    }

    /** Returns ordered offsets, encoded sizes, and headers for a complete frame stream. */
    public static List<FrameSpan> findFrameSpans(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        return findFrameSpans(src, 0, src.length);
    }

    /** Range form of {@link #findFrameSpans(byte[])}; offsets are absolute in {@code src}. */
    public static List<FrameSpan> findFrameSpans(byte[] src, int offset, int length) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.checkFromIndexSize(offset, length, src.length);
        if (length == 0) throw truncatedMetadata("Empty frame stream");
        int limit = offset + length;
        int position = offset;
        List<FrameSpan> spans = new ArrayList<>();
        while (position < limit) {
            requireAvailable(position, 4, limit, "Truncated frame magic");
            int magic = intLE(src, position);
            FrameInfo info;
            if (magic >= Zstd.SKIPPABLE_MAGIC_MIN && magic <= Zstd.SKIPPABLE_MAGIC_MAX) {
                requireAvailable(position, 8, limit, "Truncated skippable frame header");
                info = new SkippableFrameHeader(magic - Zstd.SKIPPABLE_MAGIC_MIN,
                        intLE(src, position + 4) & 0xFFFF_FFFFL, 8);
            } else if (magic == Zstd.MAGIC_NUMBER) {
                info = parseFrameHeader(src, position, limit - position);
            } else {
                throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                        "Unknown frame magic: " + Integer.toHexString(magic));
            }
            int end = scanFrameEnd(src, position, limit);
            spans.add(new FrameSpan(position, end - position, info));
            position = end;
        }
        return List.copyOf(spans);
    }

    private static int scanFrameEnd(byte[] src, int offset, int limit) {
        requireAvailable(offset, 4, limit, "Truncated frame magic");
        int magic = intLE(src, offset);
        if (magic >= Zstd.SKIPPABLE_MAGIC_MIN && magic <= Zstd.SKIPPABLE_MAGIC_MAX) {
            requireAvailable(offset, 8, limit, "Truncated skippable frame header");
            long end = (long) offset + 8 + (intLE(src, offset + 4) & 0xFFFF_FFFFL);
            if (end > limit) throw truncatedMetadata("Truncated skippable frame payload");
            return (int) end;
        }
        if (magic != Zstd.MAGIC_NUMBER) {
            throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                    "Unknown frame magic: " + Integer.toHexString(magic));
        }
        FrameHeader header = parseFrameHeader(src, offset, limit - offset);
        int position = offset + header.headerSize();
        int maxBlock = (int) Math.min(header.windowSize(), Zstd.MAX_BLOCK_SIZE);
        boolean last;
        do {
            requireAvailable(position, 3, limit, "Truncated block header");
            int blockHeader = (src[position] & 0xFF)
                    | ((src[position + 1] & 0xFF) << 8)
                    | ((src[position + 2] & 0xFF) << 16);
            position += 3;
            last = (blockHeader & 1) != 0;
            int type = (blockHeader >>> 1) & 3;
            int size = blockHeader >>> 3;
            if (type == 3 || size > maxBlock
                    || type == Zstd.BLOCK_RLE && size == 0
                    || type == Zstd.BLOCK_COMPRESSED && size < 2) {
                throw corruptMetadata("Invalid block header");
            }
            int payload = type == Zstd.BLOCK_RLE ? 1 : size;
            requireAvailable(position, payload, limit, "Truncated block payload");
            position += payload;
        } while (!last);
        if (header.checksum()) {
            requireAvailable(position, 4, limit, "Truncated content checksum");
            position += 4;
        }
        return position;
    }

    /** Creates skippable frame variant 0 containing a copy of {@code payload}. */
    public static byte[] makeSkippableFrame(byte[] payload) {
        java.util.Objects.requireNonNull(payload, "payload");
        return makeSkippableFrame(0, payload, 0, payload.length);
    }

    /** Creates a skippable frame (variant 0 through 15) around a payload range. */
    public static byte[] makeSkippableFrame(int variant, byte[] payload,
                                            int offset, int length) {
        java.util.Objects.requireNonNull(payload, "payload");
        if (variant < 0 || variant > 15) {
            throw new IllegalArgumentException("skippable frame variant must be in [0, 15]");
        }
        java.util.Objects.checkFromIndexSize(offset, length, payload.length);
        if (length > Integer.MAX_VALUE - 8) {
            throw new IllegalArgumentException("payload is too large");
        }
        byte[] frame = new byte[length + 8];
        int magic = Zstd.SKIPPABLE_MAGIC_MIN + variant;
        putIntLE(frame, 0, magic);
        putIntLE(frame, 4, length);
        System.arraycopy(payload, offset, frame, 8, length);
        return frame;
    }

    /**
     * Returns the sum of declared sizes in a concatenated frame stream, ignoring
     * skippable frames, or {@code -1} if any standard frame omits its content size.
     */
    public static long findDecompressedSize(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        return findDecompressedSize(src, 0, src.length);
    }

    /** Range form of {@link #findDecompressedSize(byte[])}. */
    public static long findDecompressedSize(byte[] src, int offset, int length) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.checkFromIndexSize(offset, length, src.length);
        if (length == 0) {
            throw new ZstdException(ZstdException.SRC_SIZE_WRONG, "Empty frame stream");
        }
        int p = offset;
        int limit = offset + length;
        long total = 0;
        boolean unknown = false;
        while (p < limit) {
            requireAvailable(p, 4, limit, "Truncated frame magic");
            int magic = intLE(src, p);
            if (magic >= Zstd.SKIPPABLE_MAGIC_MIN && magic <= Zstd.SKIPPABLE_MAGIC_MAX) {
                requireAvailable(p, 8, limit, "Truncated skippable frame header");
                long payload = intLE(src, p + 4) & 0xFFFFFFFFL;
                long next = (long) p + 8 + payload;
                if (next > limit) throw truncatedMetadata("Truncated skippable frame payload");
                p = (int) next;
                continue;
            }
            if (magic != Zstd.MAGIC_NUMBER) {
                throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                        "Unknown frame magic: " + Integer.toHexString(magic));
            }
            FrameHeader header = parseFrameHeader(src, p, limit - p);
            if (header.contentSize() < 0) {
                unknown = true;
            } else if (!unknown) {
                try {
                    total = Math.addExact(total, header.contentSize());
                } catch (ArithmeticException e) {
                    throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                            "Total decompressed size exceeds Long.MAX_VALUE", e);
                }
            }
            p += header.headerSize();
            int maxBlock = (int) Math.min(header.windowSize(), Zstd.MAX_BLOCK_SIZE);
            boolean last;
            do {
                requireAvailable(p, 3, limit, "Truncated block header");
                int blockHeader = (src[p] & 0xFF) | ((src[p + 1] & 0xFF) << 8)
                        | ((src[p + 2] & 0xFF) << 16);
                p += 3;
                last = (blockHeader & 1) != 0;
                int type = (blockHeader >>> 1) & 3;
                int size = blockHeader >>> 3;
                if (type == 3 || size > maxBlock
                        || type == Zstd.BLOCK_RLE && size == 0
                        || type == Zstd.BLOCK_COMPRESSED && size < 2) {
                    throw corruptMetadata("Invalid block header");
                }
                int payload = type == Zstd.BLOCK_RLE ? 1 : size;
                requireAvailable(p, payload, limit, "Truncated block payload");
                p += payload;
            } while (!last);
            if (header.checksum()) {
                requireAvailable(p, 4, limit, "Truncated content checksum");
                p += 4;
            }
        }
        return unknown ? -1 : total;
    }

    /**
     * Returns a safe upper bound for the regenerated bytes in a complete concatenated
     * frame stream. Unlike {@link #findDecompressedSize(byte[])}, this also works when
     * frames omit their content size by charging the maximum regeneration size for each
     * compressed block. Skippable frames contribute no output.
     */
    public static long decompressBound(byte[] src) {
        java.util.Objects.requireNonNull(src, "src");
        return decompressBound(src, 0, src.length);
    }

    /** Range form of {@link #decompressBound(byte[])}. */
    public static long decompressBound(byte[] src, int offset, int length) {
        java.util.Objects.requireNonNull(src, "src");
        java.util.Objects.checkFromIndexSize(offset, length, src.length);
        if (length == 0) {
            throw new ZstdException(ZstdException.SRC_SIZE_WRONG, "Empty frame stream");
        }
        int p = offset;
        int limit = offset + length;
        long total = 0;
        while (p < limit) {
            requireAvailable(p, 4, limit, "Truncated frame magic");
            int magic = intLE(src, p);
            if (magic >= Zstd.SKIPPABLE_MAGIC_MIN && magic <= Zstd.SKIPPABLE_MAGIC_MAX) {
                requireAvailable(p, 8, limit, "Truncated skippable frame header");
                long payload = intLE(src, p + 4) & 0xFFFF_FFFFL;
                long next = (long) p + 8 + payload;
                if (next > limit) throw truncatedMetadata("Truncated skippable frame payload");
                p = (int) next;
                continue;
            }
            if (magic != Zstd.MAGIC_NUMBER) {
                throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                        "Unknown frame magic: " + Integer.toHexString(magic));
            }
            FrameHeader header = parseFrameHeader(src, p, limit - p);
            int maxBlock = (int) Math.min(header.windowSize(), Zstd.MAX_BLOCK_SIZE);
            long frameBound = header.contentSize() >= 0 ? header.contentSize() : 0;
            p += header.headerSize();
            boolean last;
            do {
                requireAvailable(p, 3, limit, "Truncated block header");
                int blockHeader = (src[p] & 0xFF) | ((src[p + 1] & 0xFF) << 8)
                        | ((src[p + 2] & 0xFF) << 16);
                p += 3;
                last = (blockHeader & 1) != 0;
                int type = (blockHeader >>> 1) & 3;
                int size = blockHeader >>> 3;
                if (type == 3 || size > maxBlock
                        || type == Zstd.BLOCK_RLE && size == 0
                        || type == Zstd.BLOCK_COMPRESSED && size < 2) {
                    throw corruptMetadata("Invalid block header");
                }
                if (header.contentSize() < 0) {
                    long regenerated = type == Zstd.BLOCK_COMPRESSED ? maxBlock : size;
                    try {
                        frameBound = Math.addExact(frameBound, regenerated);
                    } catch (ArithmeticException e) {
                        throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                                "Decompression bound exceeds Long.MAX_VALUE", e);
                    }
                }
                int payload = type == Zstd.BLOCK_RLE ? 1 : size;
                requireAvailable(p, payload, limit, "Truncated block payload");
                p += payload;
            } while (!last);
            if (header.checksum()) {
                requireAvailable(p, 4, limit, "Truncated content checksum");
                p += 4;
            }
            try {
                total = Math.addExact(total, frameBound);
            } catch (ArithmeticException e) {
                throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                        "Decompression bound exceeds Long.MAX_VALUE", e);
            }
        }
        return total;
    }

    /** Recommended compressed-input buffer size for streaming decode. */
    public static int recommendedDStreamInputSize() {
        return Zstd.MAX_BLOCK_SIZE + 3;
    }

    /** Recommended regenerated-output buffer size for streaming decode. */
    public static int recommendedDStreamOutputSize() {
        return Zstd.MAX_BLOCK_SIZE;
    }

    /** Conservative scratch-memory estimate for one encoder at a supported level. */
    public static long estimatedCompressionMemory(int level, long sourceSizeHint) {
        if (sourceSizeHint < 0) throw new IllegalArgumentException("negative source size hint");
        Zstd.requireSupportedCompressionLevel(level);
        CompressionParameters params = CompressionParameters.get(level, sourceSizeHint);
        return estimatedParallelWorkspaceBytes(params) + (32L << 20);
    }

    /** Conservative scratch-memory estimate for one decoder at the given window cap. */
    public static long estimatedDecompressionMemory(int maxWindowLog) {
        if (maxWindowLog < Zstd.MIN_WINDOW_LOG || maxWindowLog > Zstd.MAX_WINDOW_LOG) {
            throw new IllegalArgumentException("maxWindowLog must be in ["
                    + Zstd.MIN_WINDOW_LOG + ", " + Zstd.MAX_WINDOW_LOG + "]");
        }
        return (1L << maxWindowLog) + (4L << 20);
    }

    private static FrameHeader parseFrameHeader(byte[] src, int offset, int length) {
        if (length < 5) throw truncatedMetadata("Truncated frame header");
        if (intLE(src, offset) != Zstd.MAGIC_NUMBER) {
            throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                    "Input does not start with a standard Zstandard frame");
        }
        int limit = offset + length;
        int fhd = src[offset + 4] & 0xFF;
        if ((fhd & 0x08) != 0) throw corruptMetadata("Reserved frame-header bit is set");
        boolean singleSegment = (fhd & 0x20) != 0;
        int fcsFlag = fhd >>> 6;
        int didFlag = fhd & 3;
        int didSize = didFlag == 3 ? 4 : didFlag;
        int fcsSize = fcsFlag == 0 ? (singleSegment ? 1 : 0)
                : fcsFlag == 1 ? 2 : fcsFlag == 2 ? 4 : 8;
        int headerSize = 5 + (singleSegment ? 0 : 1) + didSize + fcsSize;
        requireAvailable(offset, headerSize, limit, "Truncated frame header");
        int p = offset + 5;
        long windowSize = -1;
        if (!singleSegment) {
            int wd = src[p++] & 0xFF;
            long base = 1L << (Zstd.MIN_WINDOW_LOG + (wd >>> 3));
            windowSize = base + (base >>> 3) * (wd & 7);
        }
        long dictionaryId = unsignedLE(src, p, didSize);
        p += didSize;
        long contentSize = fcsSize == 0 ? -1 : unsignedLE(src, p, fcsSize);
        if (fcsSize == 8 && contentSize < 0) {
            throw new ZstdException(ZstdException.FRAME_PARAMETER_UNSUPPORTED,
                    "Unsigned frame content sizes above Long.MAX_VALUE are unsupported");
        }
        if (fcsSize == 2) contentSize += 256;
        if (singleSegment) windowSize = Math.max(1, contentSize);
        return new FrameHeader(contentSize, dictionaryId, windowSize,
                (fhd & 0x04) != 0, singleSegment, headerSize);
    }

    private static long unsignedLE(byte[] src, int offset, int size) {
        long value = 0;
        for (int i = 0; i < size; i++) value |= (long) (src[offset + i] & 0xFF) << (i * 8);
        return value;
    }

    private static int intLE(byte[] src, int offset) {
        return (src[offset] & 0xFF) | ((src[offset + 1] & 0xFF) << 8)
                | ((src[offset + 2] & 0xFF) << 16) | ((src[offset + 3] & 0xFF) << 24);
    }

    private static void putIntLE(byte[] dst, int offset, int value) {
        dst[offset] = (byte) value;
        dst[offset + 1] = (byte) (value >>> 8);
        dst[offset + 2] = (byte) (value >>> 16);
        dst[offset + 3] = (byte) (value >>> 24);
    }

    private static void requireAvailable(int offset, int size, int limit, String message) {
        if (size < 0 || offset < 0 || offset > limit - size) throw truncatedMetadata(message);
    }

    private static ZstdException corruptMetadata(String message) {
        return new ZstdException(ZstdException.CORRUPTION_DETECTED, message);
    }

    private static ZstdException truncatedMetadata(String message) {
        return new ZstdException(ZstdException.SRC_SIZE_WRONG, message);
    }

    private static ZstdException decompressionFailure(IOException failure) {
        if (failure instanceof java.io.EOFException) {
            return new ZstdException(ZstdException.SRC_SIZE_WRONG,
                    failure.getMessage(), failure);
        }
        return new ZstdException(ZstdException.CORRUPTION_DETECTED,
                "Decompression failed: " + failure.getMessage(), failure);
    }

    /** Decodes a compressed frame and verifies content matches source. */
    private static boolean verifyFrame(byte[] compressed, int compOff, int compLen,
                                        byte[] original, int origOff, int origLen,
                                        boolean checksum) {
        try {
            byte[] tmp = Arrays.copyOfRange(compressed, compOff, compOff + compLen);
            if (checksum) tmp[4] = (byte) (tmp[4] & ~0x04);
            byte[] frame = checksum ? Arrays.copyOf(tmp, compLen - 4) : tmp;
            // The frame may legitimately use an explicit window log above the decoder's
            // conservative default (large-window encodes); verification must accept it.
            byte[] back = decompress(frame, Zstd.MAX_WINDOW_LOG);
            if (back.length != origLen) return false;
            for (int i = 0; i < origLen; i++) {
                if (back[i] != original[origOff + i]) return false;
            }
            return true;
        } catch (Exception e) {
            return false;
        }
    }

    /** Fallback: compress using only raw blocks (guaranteed correct, poor ratio). */
    private static int compressRawInto(byte[] src, int off, int len,
                                       byte[] dst, int dstOff, boolean checksum) {
        CompressionParameters params = CompressionParameters.get(1, len);
        int blockSize = Math.min(params.blockSize(), Zstd.MAX_BLOCK_SIZE);
        XxHash64 hasher = new XxHash64();

        int p = dstOff + FrameWriter.writeFrameHeader(dst, dstOff, len,
                Math.max(params.windowLog, Zstd.MIN_WINDOW_LOG), checksum,
                fitsSingleSegment(len, params));

        int pos = off;
        final int end = off + len;
        if (len == 0) {
            p += FrameWriter.writeRawBlock(dst, p, src, 0, 0, true);
        }
        while (pos < end) {
            int take = Math.min(blockSize, end - pos);
            boolean last = pos + take >= end;
            hasher.update(src, pos, take);
            p += FrameWriter.writeRawBlock(dst, p, src, pos, take, last);
            pos += take;
        }
        if (checksum) {
            long h = hasher.getValue() & 0xFFFFFFFFL;
            dst[p++] = (byte) h;
            dst[p++] = (byte) (h >> 8);
            dst[p++] = (byte) (h >> 16);
            dst[p++] = (byte) (h >> 24);
        }
        return p - dstOff;
    }
}

package dev.jzstd;

/** Format-level constants of the Zstandard frame specification (RFC 8878). */
public final class Zstd {

    /** Version of the implemented frame format. */
    public static final String VERSION = "1.5.7";

    public static final int MAGIC_NUMBER = 0xFD2FB528;
    public static final int SKIPPABLE_MAGIC_MIN = 0x184D2A50;
    public static final int SKIPPABLE_MAGIC_MAX = 0x184D2A5F;
    /** Magic of formatted dictionaries produced by the reference trainer. */
    public static final int DICTIONARY_MAGIC = 0xEC30A437;

    public static final int MIN_WINDOW_LOG = 10;
    public static final int MAX_WINDOW_LOG = 31;
    public static final int MAX_BLOCK_SIZE = 128 * 1024;
    public static final int DEFAULT_COMPRESSION_LEVEL = 3;
    private static final int[] SUPPORTED_COMPRESSION_LEVELS = {-1, 1, 3, 9, 19, 22};

    /** Block types. */
    public static final int BLOCK_RAW = 0;
    public static final int BLOCK_RLE = 1;
    public static final int BLOCK_COMPRESSED = 2;

    /** Literals section types. */
    public static final int LITERALS_RAW = 0;
    public static final int LITERALS_RLE = 1;
    public static final int LITERALS_COMPRESSED = 2;
    public static final int LITERALS_TREELESS = 3;

    /** Lowest accepted encoder level; support is sparse, not every value in the range. */
    public static final int MIN_LEVEL = -1;
    public static final int MAX_LEVEL = 22;

    /** Returns a new array containing every accepted encoder level. */
    public static int[] supportedCompressionLevels() {
        return SUPPORTED_COMPRESSION_LEVELS.clone();
    }

    /** Returns whether {@code level} is accepted by the encoder. */
    public static boolean isSupportedCompressionLevel(int level) {
        return level == -1 || level == 1 || level == 3
                || level == 9 || level == 19 || level == 22;
    }

    static void requireSupportedCompressionLevel(int level) {
        if (!isSupportedCompressionLevel(level)) {
            throw new IllegalArgumentException("unsupported compression level " + level
                    + "; supported levels are -1, 1, 3, 9, 19, and 22");
        }
    }

    private Zstd() {}
}

package dev.jzstd;

/**
 * One-shot encoder options for callers that need an explicit large match window.
 * A zero {@code windowLog} selects the level default. Enabling long-distance matching
 * requires an explicit window log in the range 27..31 and emits that window in the frame.
 *
 * @param level one of {@link Zstd#supportedCompressionLevels()}
 * @param checksum whether to append and verify a content checksum
 * @param windowLog zero for the level default, otherwise the explicit large window log
 * @param longDistanceMatching whether the explicit large history window is enabled
 */
public record ZstdCompressionOptions(int level, boolean checksum, int windowLog,
                                     boolean longDistanceMatching) {

    public ZstdCompressionOptions {
        Zstd.requireSupportedCompressionLevel(level);
        if (windowLog != 0
                && (windowLog < Zstd.MIN_WINDOW_LOG || windowLog > Zstd.MAX_WINDOW_LOG)) {
            throw new IllegalArgumentException("windowLog must be 0 or in ["
                    + Zstd.MIN_WINDOW_LOG + ", " + Zstd.MAX_WINDOW_LOG + "]");
        }
        if (longDistanceMatching && windowLog < 27) {
            throw new IllegalArgumentException(
                    "long-distance matching requires an explicit windowLog in [27, 31]");
        }
        if (!longDistanceMatching && windowLog != 0) {
            throw new IllegalArgumentException(
                    "an explicit windowLog requires long-distance matching");
        }
    }

    public static ZstdCompressionOptions defaults(int level) {
        return new ZstdCompressionOptions(level, true, 0, false);
    }

    public ZstdCompressionOptions withChecksum(boolean enabled) {
        return new ZstdCompressionOptions(level, enabled, windowLog, longDistanceMatching);
    }

    public ZstdCompressionOptions withLongDistanceMatching(int requestedWindowLog) {
        return new ZstdCompressionOptions(level, checksum, requestedWindowLog, true);
    }
}

package dev.jzstd;

import dev.jzstd.internal.Bits;
import dev.jzstd.internal.DictionaryData;
import dev.jzstd.internal.Fse;
import dev.jzstd.internal.Huf;
import dev.jzstd.internal.SeqConstants;

/**
 * A decompression/compression dictionary: either raw content (any bytes, at least 8)
 * or a formatted dictionary as produced by the reference trainer (RFC 8878 section 5).
 */
public final class ZstdDictionary {

    private final DictionaryData data;

    private ZstdDictionary(DictionaryData data) {
        this.data = data;
    }

    /** Wraps raw dictionary content. */
    public static ZstdDictionary raw(byte[] content) {
        java.util.Objects.requireNonNull(content, "content");
        if (content.length < 8) {
            throw new IllegalArgumentException("Raw dictionary must be at least 8 bytes");
        }
        return new ZstdDictionary(DictionaryData.raw(content.clone()));
    }

    /** Parses a dictionary buffer, auto-detecting formatted vs raw content. */
    public static ZstdDictionary parse(byte[] dict) {
        java.util.Objects.requireNonNull(dict, "dict");
        if (dict.length >= 4 && Bits.getInt(dict, 0) == Zstd.DICTIONARY_MAGIC) {
            return new ZstdDictionary(parseFormatted(dict));
        }
        return raw(dict);
    }

    private static DictionaryData parseFormatted(byte[] dict) {
        try {
            long id = Bits.getInt(dict, 4) & 0xFFFFFFFFL;
            if (id == 0) {
                throw new ZstdException(ZstdException.DICTIONARY_CORRUPTED, "Dictionary ID must be nonzero");
            }
            int off = 8;
            int limit = dict.length - 12;
            Huf.DTable huf = new Huf.DTable();
            byte[] weightScratch = new byte[Huf.MAX_SYMBOL_VALUE + 1];
            Fse.Counts counts = new Fse.Counts(Huf.MAX_SYMBOL_VALUE);
            off += Huf.readTree(dict, off, limit, huf, counts, weightScratch);

            int[] consumed = new int[1];
            Fse.DTable of = readFseDictTable(dict, off, limit, SeqConstants.MAX_OFFSET_CODE, 8, consumed);
            off += consumed[0];
            Fse.DTable ml = readFseDictTable(dict, off, limit, SeqConstants.MAX_ML_CODE, 9, consumed);
            off += consumed[0];
            Fse.DTable ll = readFseDictTable(dict, off, limit, SeqConstants.MAX_LL_CODE, 9, consumed);
            off += consumed[0];

            int[] rep = new int[3];
            for (int i = 0; i < 3; i++) {
                rep[i] = Bits.getInt(dict, off + 4 * i);
            }
            off += 12;
            int contentLen = dict.length - off;
            if (contentLen < 8) {
                throw new ZstdException(ZstdException.DICTIONARY_CORRUPTED, "Dictionary content too small");
            }
            for (int r : rep) {
                if (r <= 0 || r > contentLen) {
                    throw new ZstdException(ZstdException.DICTIONARY_CORRUPTED,
                            "Dictionary repeat offset out of range");
                }
            }
            byte[] content = java.util.Arrays.copyOfRange(dict, off, dict.length);
            return new DictionaryData(content, rep, id, huf, ll, of, ml);
        } catch (ZstdException e) {
            throw e;
        } catch (RuntimeException e) {
            throw new ZstdException(ZstdException.DICTIONARY_CORRUPTED, "Malformed dictionary", e);
        }
    }

    private static Fse.DTable readFseDictTable(byte[] dict, int off, int limit,
                                               int maxSymbol, int maxLog, int[] consumedOut) {
        Fse.Counts c = new Fse.Counts(maxSymbol);
        consumedOut[0] = Fse.readCounts(dict, off, limit, maxSymbol, maxLog, c);
        Fse.DTable t = new Fse.DTable(maxLog);
        Fse.buildDecoder(c, t);
        return t;
    }

    public byte[] content() {
        return data.content;
    }

    public long id() {
        return data.id;
    }

    /** Creates an immutable level-specific handle for repeated compression calls. */
    public ZstdPreparedDictionary prepare(int compressionLevel) {
        return new ZstdPreparedDictionary(this, compressionLevel);
    }

    dev.jzstd.internal.DictionaryData data() {
        return data;
    }
}

package dev.jzstd;

/**
 * Thrown when malformed, truncated or otherwise invalid Zstandard data is encountered,
 * or when parameters are outside the supported range.
 */
public class ZstdException extends RuntimeException {

    private final int code;

    public ZstdException(int code, String message) {
        super(message);
        this.code = code;
    }

    public ZstdException(int code, String message, Throwable cause) {
        super(message, cause);
        this.code = code;
    }

    /** Error classification, mirroring the categories of the format specification. */
    public int code() {
        return code;
    }

    public static final int GENERIC = 1;
    public static final int CORRUPTION_DETECTED = 2;
    public static final int FRAME_PARAMETER_UNSUPPORTED = 3;
    public static final int DICTIONARY_CORRUPTED = 4;
    public static final int DESTINATION_TOO_SMALL = 5;
    public static final int SRC_SIZE_WRONG = 6;
    public static final int CHECKSUM_MISMATCH = 7;
    /** The frame requires a dictionary that was not supplied or does not match. */
    public static final int DICTIONARY_WRONG = 8;
}

package dev.jzstd;

import java.io.IOException;

/** Checked streaming form of a {@link ZstdException}. */
public final class ZstdIOException extends IOException {
    private final int code;

    public ZstdIOException(ZstdException cause) {
        super(cause.getMessage(), cause);
        this.code = cause.code();
    }

    public int code() {
        return code;
    }
}

package dev.jzstd;

import dev.jzstd.internal.FrameDecoder;
import dev.jzstd.internal.InputBuffer;

import java.io.IOException;
import java.io.InputStream;

/**
 * Streaming decompressor: reads a zstd stream (one or more concatenated frames, with
 * optional skippable frames) from an underlying {@link InputStream}.
 */
public final class ZstdInputStream extends InputStream {

    private InputStream source;
    private InputBuffer input;
    private FrameDecoder decoder = new FrameDecoder();
    private final byte[] singleByte = new byte[1];

    private boolean endReached;
    private boolean closed;
    private boolean started;
    private boolean continuous;
    private boolean temporaryEnd;
    private boolean failed;

    /** Receives skippable metadata incrementally, without buffering its whole payload. */
    public interface SkippableFrameListener {
        void onStart(Jzstd.SkippableFrameHeader header) throws IOException;
        void onData(byte[] data, int offset, int length) throws IOException;
        void onEnd() throws IOException;
    }

    public ZstdInputStream(InputStream source) {
        this.source = java.util.Objects.requireNonNull(source, "source");
        this.input = new InputBuffer(source);
    }

    /** Associates a dictionary used to decode frames (raw content or formatted). */
    public void setDictionary(ZstdDictionary dictionary) {
        ensureConfigurable();
        decoder.setDictionary(java.util.Objects.requireNonNull(dictionary, "dictionary").data());
    }

    /** Caps the window size of accepted frames, expressed as windowLog (default 27). */
    public void setMaxWindowLog(int maxWindowLog) {
        ensureConfigurable();
        decoder.setMaxWindowLog(maxWindowLog);
    }

    /** Caps regenerated bytes across all standard frames in this stream. */
    public void setMaxOutputSize(long maxOutputSize) {
        ensureConfigurable();
        decoder.setMaxOutputSize(maxOutputSize);
    }

    /** Allows reads to resume after temporary EOF while a frame or growing stream is incomplete. */
    public void setContinuous(boolean continuous) {
        ensureConfigurable();
        this.continuous = continuous;
    }

    /** Registers a chunked observer for skippable-frame metadata. */
    public void setSkippableFrameListener(SkippableFrameListener listener) {
        ensureConfigurable();
        if (listener == null) {
            decoder.setSkippableHandler(null);
            return;
        }
        decoder.setSkippableHandler(new FrameDecoder.SkippableHandler() {
            @Override
            public void onStart(int variant, long payloadSize) throws IOException {
                listener.onStart(new Jzstd.SkippableFrameHeader(variant, payloadSize, 8));
            }

            @Override
            public void onData(byte[] data, int offset, int length) throws IOException {
                listener.onData(data, offset, length);
            }

            @Override
            public void onEnd() throws IOException {
                listener.onEnd();
            }
        });
    }

    /** Returns the latest parsed standard-frame header, or {@code null} before one is read. */
    public Jzstd.FrameHeader currentFrameHeader() {
        return decoder == null ? null : decoder.currentFrameHeader();
    }

    /** Decodes one frame whose four-byte zstd magic is carried out of band. */
    public void setMagicless(boolean magicless) {
        ensureConfigurable();
        decoder.setMagicless(magicless);
        decoder.resetStream();
    }

    private void fill() throws IOException {
        temporaryEnd = false;
        while (decoder.availableDecoded() == 0) {
            if (endReached) {
                return;
            }
            try {
                started = true;
                if (!decoder.advance(input)) {
                    if (continuous) {
                        input.resumeAfterEof();
                        temporaryEnd = true;
                    } else {
                        endReached = true;
                    }
                    return;
                }
            } catch (ZstdException e) {
                failed = true;
                throw new ZstdIOException(e);
            } catch (java.io.EOFException e) {
                if (continuous) {
                    input.resumeAfterEof();
                    temporaryEnd = true;
                    return;
                }
                failed = true;
                throw new ZstdIOException(new ZstdException(
                        ZstdException.SRC_SIZE_WRONG, e.getMessage(), e));
            } catch (IOException e) {
                failed = true;
                throw e;
            }
        }
    }

    @Override
    public int read() throws IOException {
        int n = read(singleByte, 0, 1);
        return n == 1 ? (singleByte[0] & 0xFF) : -1;
    }

    @Override
    public int read(byte[] b, int off, int len) throws IOException {
        java.util.Objects.checkFromIndexSize(off, len, b.length);
        if (closed) {
            throw new IOException("Stream closed");
        }
        if (failed) throw new IOException("Stream is unusable after a previous failure");
        if (len == 0) {
            return 0;
        }
        fill();
        if ((endReached || temporaryEnd) && decoder.availableDecoded() == 0) {
            return -1;
        }
        return decoder.readDecoded(b, off, len);
    }

    @Override
    public int available() throws IOException {
        if (closed) throw new IOException("Stream closed");
        return decoder.availableDecoded();
    }

    @Override
    public void close() throws IOException {
        if (closed) return;
        closed = true;
        InputStream toClose = source;
        try {
            if (toClose != null) toClose.close();
        } finally {
            source = null;
            input = null;
            decoder = null;
        }
    }

    private void ensureConfigurable() {
        if (closed) throw new IllegalStateException("Stream closed");
        if (started) throw new IllegalStateException(
                "decoder options must be selected before reading");
    }
}

package dev.jzstd;

import dev.jzstd.internal.BlockCompressor;
import dev.jzstd.internal.CompressionParameters;
import dev.jzstd.internal.DictionaryData;
import dev.jzstd.internal.FrameWriter;
import dev.jzstd.internal.ScratchPool;
import dev.jzstd.internal.Workspace;
import dev.jzstd.internal.XxHash64;

import java.io.IOException;
import java.io.OutputStream;
import java.util.Objects;

/**
 * Bounded-memory streaming compressor. The whole stream is one Zstandard frame: match
 * history, entropy tables and repeat offsets carry across block boundaries, and the
 * window slides once the staging buffer fills. A normal {@link #flush()} emits complete
 * non-final blocks while keeping the frame open; {@link #finishFrame()} ends it
 * explicitly. Instances are not thread-safe.
 *
 * <p>{@code chunkSize} is the window budget: it bounds both the match window and the
 * staging buffer, and therefore how far back the compressor can reference. Streams whose
 * redundancy spans more than that need a larger value.
 */
public final class ZstdOutputStream extends OutputStream {

    public static final int DEFAULT_CHUNK_SIZE = 1 << 20;
    private static final int TREE_RESEED_STEP = Math.max(1,
            Integer.getInteger("jzstd.treeReseedStep", 256));

    private final OutputStream target;
    private final int level;
    private final boolean checksum;
    private final ZstdDictionary dictionary;
    private final DictionaryData dictionaryData;
    private final CompressionParameters params;
    private final int dictionaryLength;
    private final int windowSize;
    private final int blockSize;
    /** Buffer size at which the window slides; holds the window plus fresh staging. */
    private final int capacity;
    private final byte[] compressedBuffer;
    private final XxHash64 hasher = new XxHash64();

    private byte[] input;
    private Workspace workspace;
    private long leaseEpoch;
    /** Valid bytes in {@code input}, including any retained dictionary or history. */
    private int count;
    /** Prefix of {@code input} already written out as blocks. */
    private int emitted;
    private boolean frameStarted;
    private boolean wroteFrame;
    private boolean closed;
    /** Any failed emission makes the encoder state impossible to resume safely. */
    private boolean failed;
    private Throwable failureCause;
    /** Declared size for the current frame, or -1 when the stream is unpledged. */
    private long pledgedContentSize = -1;
    private long acceptedContentSize;
    private boolean magicless;

    public ZstdOutputStream(OutputStream target, int level) {
        this(target, level, true);
    }

    public ZstdOutputStream(OutputStream target, int level, boolean checksum) {
        this(target, level, checksum, DEFAULT_CHUNK_SIZE);
    }

    public ZstdOutputStream(OutputStream target, int level, ZstdDictionary dictionary) {
        this(target, level, true, DEFAULT_CHUNK_SIZE, dictionary);
    }

    public ZstdOutputStream(OutputStream target, ZstdPreparedDictionary dictionary) {
        this(target, dictionary.compressionLevel(), true, DEFAULT_CHUNK_SIZE,
                dictionary.dictionary());
    }

    public ZstdOutputStream(OutputStream target, ZstdPreparedDictionary dictionary,
                            boolean checksum, int chunkSize) {
        this(target, dictionary.compressionLevel(), checksum, chunkSize,
                dictionary.dictionary());
    }

    public ZstdOutputStream(OutputStream target, int level, boolean checksum,
                            ZstdDictionary dictionary) {
        this(target, level, checksum, DEFAULT_CHUNK_SIZE, dictionary);
    }

    public ZstdOutputStream(OutputStream target, int level, boolean checksum, int chunkSize) {
        this(target, level, checksum, chunkSize, null);
    }

    /** Creates a bounded stream, optionally using dictionary history in every frame. */
    public ZstdOutputStream(OutputStream target, int level, boolean checksum,
                            int chunkSize, ZstdDictionary dictionary) {
        Zstd.requireSupportedCompressionLevel(level);
        this.target = Objects.requireNonNull(target, "target");
        if (chunkSize <= 0) throw new IllegalArgumentException("chunkSize must be positive");
        this.level = level;
        this.checksum = checksum;
        this.dictionary = dictionary;
        this.dictionaryData = dictionary == null ? null : dictionary.data();
        this.params = CompressionParameters.get(level, chunkSize);
        this.windowSize = params.windowSize();
        this.blockSize = params.blockSize();
        this.dictionaryLength = dictionaryData == null ? 0
                : Math.min(dictionaryData.content.length, windowSize);
        // One window of retained history plus at least a window of fresh staging, so a
        // slide costs one re-seed of the window per window of new input.
        long room = (long) dictionaryLength + windowSize
                + Math.max(blockSize, windowSize);
        if (room > Integer.MAX_VALUE - 8L) {
            throw new IllegalArgumentException("dictionary plus window is too large");
        }
        this.capacity = (int) room;
        this.input = new byte[Math.min(capacity,
                dictionaryLength + Math.max(blockSize, 1 << 16))];
        primeDictionary();
        this.compressedBuffer = new byte[Jzstd.compressBound(blockSize)];
    }

    @Override
    public void write(int b) throws IOException {
        ensureOpen();
        requirePledgedRoom(1);
        makeRoom();
        input[count++] = (byte) b;
        acceptedContentSize++;
        if (checksum) hasher.update(input, count - 1, 1);
        emitFullBlocks();
    }

    @Override
    public void write(byte[] b, int off, int len) throws IOException {
        ensureOpen();
        Objects.checkFromIndexSize(off, len, b.length);
        requirePledgedRoom(len);
        while (len > 0) {
            makeRoom();
            int take = Math.min(len, input.length - count);
            System.arraycopy(b, off, input, count, take);
            if (checksum) hasher.update(input, count, take);
            count += take;
            acceptedContentSize += take;
            off += take;
            len -= take;
            emitFullBlocks();
        }
    }

    /** Emits pending blocks but, like native {@code ZSTD_flushStream}, keeps the frame open. */
    @Override
    public void flush() throws IOException {
        ensureOpen();
        if (count > emitted) emitBlocks(true, false);
        target.flush();
    }

    /** Ends the current frame. An empty current stream produces one valid empty frame. */
    public void finishFrame() throws IOException {
        ensureOpen();
        finishFrameInternal();
    }

    /**
     * Declares the exact number of source bytes in the next frame. The size must be set
     * before any content is written. It is encoded in the frame header and enforced on
     * both write and finish, enabling single-segment framing when it fits the window.
     */
    public void setPledgedSrcSize(long size) throws IOException {
        ensureOpen();
        if (size < 0) throw new IllegalArgumentException("pledged size must be non-negative");
        if (frameStarted || acceptedContentSize != 0 || count != dictionaryLength) {
            throw new IllegalStateException("pledged size must be set before frame content");
        }
        pledgedContentSize = size;
    }

    /** Omits the four-byte zstd magic from the next frame header. */
    public void setMagicless(boolean magicless) throws IOException {
        ensureOpen();
        if (frameStarted || acceptedContentSize != 0 || count != dictionaryLength) {
            throw new IllegalStateException("format must be selected before frame content");
        }
        this.magicless = magicless;
    }

    @Override
    public void close() throws IOException {
        if (closed) return;
        closed = true;
        Throwable failure = failed ? failureCause : null;
        try {
            if (!failed && (frameStarted || count > emitted || !wroteFrame)) {
                finishFrameInternal();
            }
        } catch (Throwable t) {
            failure = t;
        } finally {
            releaseWorkspace();
            input = null;
        }
        try {
            target.close();
        } catch (Throwable closeFailure) {
            if (failure == null) failure = closeFailure;
            else failure.addSuppressed(closeFailure);
        }
        rethrowCloseFailure(failure);
    }

    /**
     * Guarantees at least one writable byte, growing the buffer toward {@link #capacity}
     * and sliding the window once it is reached.
     */
    private void makeRoom() throws IOException {
        if (count < input.length) return;
        if (input.length < capacity) {
            int grown = (int) Math.min(capacity, Math.max((long) input.length * 2,
                    (long) input.length + blockSize));
            input = java.util.Arrays.copyOf(input, grown);
            return;
        }
        slideWindow();
    }

    /**
     * Drops the oldest history, rebasing the buffer to index zero. Buffer positions are
     * the matcher's coordinate system, so the matcher restarts on a fresh generation and
     * the retained window is re-seeded as history through the same path a dictionary
     * uses. The frame, its entropy tables and its repeat offsets all continue.
     */
    private void slideWindow() throws IOException {
        emitBlocks(true, false);
        int keep = Math.min(count, windowSize);
        int delta = count - keep;
        if (delta <= 0) {
            throw new IllegalStateException("window slide made no progress");
        }
        System.arraycopy(input, delta, input, 0, keep);
        count = keep;
        emitted = keep;
        workspace.restartMatcher();
        workspace.seedCompressionDictionary(0, keep,
                params.usesSuffixTree() ? TREE_RESEED_STEP : 1);
    }

    private void emitFullBlocks() throws IOException {
        if (count - emitted >= blockSize) emitBlocks(false, false);
    }

    /**
     * Compresses staged bytes into blocks.
     *
     * @param drainPartial when false, stops before a trailing partial block so full-size
     *                     blocks keep their entropy advantage
     * @param lastFrame    marks the final block and permits an empty terminating block
     */
    private void emitBlocks(boolean drainPartial, boolean lastFrame) throws IOException {
        try {
            emitBlocksUnchecked(drainPartial, lastFrame);
        } catch (IOException | RuntimeException | Error failure) {
            poison(failure);
            throw failure;
        }
    }

    private void emitBlocksUnchecked(boolean drainPartial, boolean lastFrame)
            throws IOException {
        startFrame();
        if (emitted == count && lastFrame) {
            int produced = FrameWriter.writeRawBlock(compressedBuffer, 0,
                    input, emitted, 0, true);
            target.write(compressedBuffer, 0, produced);
            return;
        }
        while (emitted < count) {
            int available = count - emitted;
            if (!drainPartial && available < blockSize) break;
            int take = Math.min(available, BlockCompressor.selectBlockSize(workspace,
                    input, emitted, available, blockSize, params,
                    emitted == dictionaryLength));
            boolean last = lastFrame && emitted + take == count;
            int produced = BlockCompressor.compressBlock(workspace, input, emitted, take,
                    compressedBuffer, 0, workspace.repOffsets,
                    Math.max(0, emitted - windowSize), count, capacity, params, last);
            if (produced < 0) {
                produced = FrameWriter.writeRawBlock(compressedBuffer, 0,
                        input, emitted, take, last);
            }
            workspace.splitSavings += take - produced;
            target.write(compressedBuffer, 0, produced);
            emitted += take;
        }
    }

    private void startFrame() throws IOException {
        if (frameStarted) return;
        leaseEpoch = ScratchPool.epoch();
        workspace = ScratchPool.acquireWorkspace();
        workspace.resetCompression(params);
        if (dictionaryLength != 0) {
            workspace.seedCompressionDictionary(0, dictionaryLength);
            if (dictionaryData.rep != null) {
                System.arraycopy(dictionaryData.rep, 0, workspace.repOffsets, 0, 3);
            }
        }
        boolean singleSegment = pledgedContentSize >= 0
                && pledgedContentSize <= windowSize;
        int header = FrameWriter.writeFrameHeader(compressedBuffer, 0, pledgedContentSize,
                params.windowLog, checksum, singleSegment,
                dictionaryData == null ? 0 : dictionaryData.id, magicless);
        frameStarted = true;
        target.write(compressedBuffer, 0, header);
    }

    private void finishFrameInternal() throws IOException {
        try {
            if (pledgedContentSize >= 0 && acceptedContentSize != pledgedContentSize) {
                throw new IOException("Pledged source size mismatch: expected "
                        + pledgedContentSize + ", got " + acceptedContentSize);
            }
            emitBlocks(true, true);
            if (checksum) {
                long hash = hasher.getValue() & 0xFFFFFFFFL;
                compressedBuffer[0] = (byte) hash;
                compressedBuffer[1] = (byte) (hash >>> 8);
                compressedBuffer[2] = (byte) (hash >>> 16);
                compressedBuffer[3] = (byte) (hash >>> 24);
                target.write(compressedBuffer, 0, 4);
            }
        } catch (IOException | RuntimeException | Error failure) {
            poison(failure);
            throw failure;
        }
        wroteFrame = true;
        frameStarted = false;
        hasher.reset(0L);
        count = 0;
        emitted = 0;
        pledgedContentSize = -1;
        acceptedContentSize = 0;
        primeDictionary();
        releaseWorkspace();
    }

    /** Restores the dictionary prefix that every frame starts from. */
    private void primeDictionary() {
        if (dictionaryLength == 0) return;
        System.arraycopy(dictionaryData.content,
                dictionaryData.content.length - dictionaryLength,
                input, 0, dictionaryLength);
        count = dictionaryLength;
        emitted = dictionaryLength;
    }

    private void releaseWorkspace() {
        if (workspace != null) {
            ScratchPool.releaseWorkspace(workspace, leaseEpoch);
            workspace = null;
        }
    }

    private void ensureOpen() throws IOException {
        if (closed) throw new IOException("Stream closed");
        if (failed) throw new IOException("Stream is unusable after a previous failure");
    }

    private void requirePledgedRoom(int length) throws IOException {
        if (pledgedContentSize >= 0 && length > pledgedContentSize - acceptedContentSize) {
            IOException failure = new IOException(
                    "Write exceeds pledged source size " + pledgedContentSize);
            poison(failure);
            throw failure;
        }
    }

    private void poison(Throwable failure) {
        failed = true;
        if (failureCause == null) failureCause = failure;
    }

    private static void rethrowCloseFailure(Throwable failure) throws IOException {
        if (failure == null) return;
        if (failure instanceof IOException io) throw io;
        if (failure instanceof RuntimeException runtime) throw runtime;
        if (failure instanceof Error error) throw error;
        throw new IOException("Failed to close zstd stream", failure);
    }
}

package dev.jzstd;

import java.util.Objects;

/**
 * Immutable, shareable dictionary handle bound to a compression level. Formatted
 * entropy tables are parsed by {@link ZstdDictionary}; this handle also makes the
 * intended encoder profile explicit for repeated and parallel use.
 */
public final class ZstdPreparedDictionary {
    private final ZstdDictionary dictionary;
    private final int level;

    ZstdPreparedDictionary(ZstdDictionary dictionary, int level) {
        this.dictionary = Objects.requireNonNull(dictionary, "dictionary");
        Zstd.requireSupportedCompressionLevel(level);
        this.level = level;
    }

    ZstdDictionary dictionary() {
        return dictionary;
    }

    public int compressionLevel() {
        return level;
    }
}

package dev.jzstd.internal;

import dev.jzstd.ZstdException;

/**
 * Bit reader for zstd entropy-coded bitstreams.
 * <p>
 * These streams are written forward by the encoder and consumed from the END of the buffer
 * toward the start, MSB-first within each byte. The caller must guarantee at least 8 readable
 * bytes before {@code origin} (decoders run on head-padded scratch buffers). Reads past the
 * start yield zero bits, per the format's overflow rule; {@link #remainingBits()} reports
 * the exact signed overrun.
 */
public final class BitReader {


    private byte[] buf;
    /** Inclusive lower bound of the stream. */
    private int origin;
    /** Index of the next 8-byte window to load; moves down toward origin and clamps there. */
    private int pos;
    private long container;
    private int bitsConsumed;
    /** Total useful bits in the stream (padding marker excluded). */
    private int totalBits;
    /** Useful bits committed by prior refills; current-window consumption is separate. */
    private int consumedBase;
    private boolean overflow;
    /** True once the window is pinned at the region start with a short top-aligned load. */
    private boolean clamped;

    /**
     * Initializes the reader over the stream {@code [origin, endExclusive)} whose last byte
     * carries the format-mandated final-bit marker (highest set bit); up to 7 zero padding
     * bits above it are skipped automatically.
     */
    public void init(byte[] array, int endExclusive, int origin) {
        int lastByte = array[endExclusive - 1] & 0xFF;
        if (lastByte == 0) {
            throw new ZstdException(ZstdException.CORRUPTION_DETECTED,
                    "Entropy bitstream ends with zero byte");
        }
        init(array, endExclusive, origin, 8 - Bits.highBit(lastByte));
    }

    /** Variant with explicit initial skip (experimentation hook). */
    public void init(byte[] array, int endExclusive, int origin, int markerSkip) {
        this.buf = array;
        this.origin = origin;
        this.totalBits = ((endExclusive - origin) << 3) - markerSkip;
        this.pos = endExclusive - 8;
        if (pos < origin) {
            int len = endExclusive - origin;
            this.pos = origin;
            this.container = Bits.readPartialLong(array, origin, len) << (64 - (len << 3));
        } else {
            this.container = Bits.getLong(array, pos);
        }
        this.bitsConsumed = markerSkip;
        // bitsConsumed initially includes the format marker; exclude it from the
        // useful-bit count without updating a second counter on every read.
        this.consumedBase = -markerSkip;
        this.overflow = false;
        this.clamped = pos == origin;
    }

    /**
     * Loads the next word once enough bits have been consumed. Call between groups of reads;
     * the trigger leaves room for single reads up to 31 bits.
     */
    public void refill() {
        if (bitsConsumed <= 32) {
            return;
        }
        refillWindow();
    }

    private void refillWindow() {
        int bytes = bitsConsumed >>> 3;
        int newBits = bitsConsumed - (bytes << 3);
        int newPos = pos - bytes;
        if (newPos >= origin) {
            consumedBase += bytes << 3;
            pos = newPos;
            bitsConsumed = newBits;
            container = Bits.getLong(buf, pos);
            return;
        }
        overflow = true;
        if (clamped) {
            // Already pinned at the origin: the container plus its zero-fill covers every
            // remaining (virtual) bit; reloading would truncate real data.
            return;
        }
        consumedBase += bytes << 3;
        pos = origin;
        clamped = true;
        int available = newPos + 8 - origin;
        if (available > 0) {
            // Partial window, top-aligned: valid bytes occupy the high bits, zero-fill below.
            container = Bits.readPartialLong(buf, origin, available) << (64 - (available << 3));
        } else {
            // Entirely past the start: every further read yields zero bits.
            container = 0;
        }
        bitsConsumed = newBits;
    }

    public int readBits(int count) {
        int value = extract(count);
        bitsConsumed += count;
        return value;
    }

    /** Reads a field whose width the caller has already proved non-zero. */
    public int readBitsNonZero(int count) {
        int value = extractNonZero(count);
        bitsConsumed += count;
        return value;
    }

    /**
     * Reads a 1..63 bit field, refilling first when it does not fit in the current word.
     * This is for sequence slices whose combined extra and transition fields are wider
     * than the 31-bit fields handled by the ordinary reader.
     */
    public long readBitsLongNonZero(int count) {
        if (bitsConsumed > 64 - count) {
            refillWindow();
            if (!clamped && bitsConsumed > 64 - count) {
                // Removing whole consumed bytes can still leave a 1..7 bit alignment
                // prefix. A 57..63 bit slice then straddles two words; join the small
                // tail here instead of forcing the decoder back through four reads.
                int highWidth = 64 - bitsConsumed;
                long high = extractLongNonZero(highWidth);
                bitsConsumed += highWidth;
                refillWindow();
                int lowWidth = count - highWidth;
                long low = extractLongNonZero(lowWidth);
                bitsConsumed += lowWidth;
                return (high << lowWidth) | low;
            }
        }
        long value = extractLongNonZero(count);
        bitsConsumed += count;
        return value;
    }

    public int peekBits(int count) {
        return extract(count);
    }

    private int extract(int count) {
        if (count == 0) {
            return 0;
        }
        return extractNonZero(count);
    }

    private int extractNonZero(int count) {
        int shift = 64 - bitsConsumed - count;
        if (shift >= 0) {
            return (int) ((container >>> shift) & Bits.mask64(count));
        }
        // Field extends below the window bottom (clamped at origin): those low bits are
        // format-defined zeros; a left shift materializes them exactly.
        return (int) ((container << -shift) & Bits.mask64(count));
    }

    private long extractLongNonZero(int count) {
        int shift = 64 - bitsConsumed - count;
        if (shift >= 0) {
            return (container >>> shift) & Bits.mask64(count);
        }
        int zeroFill = -shift;
        return zeroFill >= Long.SIZE ? 0 : (container << zeroFill) & Bits.mask64(count);
    }

    public void skipBits(int count) {
        bitsConsumed += count;
    }

    /** Advisory flag: the stream was consumed past its start (corrupt input). */
    public boolean isOverflow() {
        return overflow;
    }

    /** Exact number of unconsumed useful bits; negative means overrun. */
    public int remainingBits() {
        return totalBits - consumedBase - bitsConsumed;
    }

    public int position() {
        return pos;
    }

    public int bitsConsumed() {
        return bitsConsumed;
    }

    public long debugContainer() {
        return container;
    }

    public int debugAvail() {
        return ((pos - origin) << 3) + 64 - bitsConsumed;
    }
}

package dev.jzstd.internal;

/**
 * Bit writer for zstd entropy-coded bitstreams.
 * <p>
 * Bits accumulate LSB-first and are flushed as whole bytes moving forward through the buffer.
 * A stream produced this way is consumed by {@link BitReader} from the end, MSB-first.
 * The writer must never hold 64 bits: {@link #flushBytes} shifts the container right by
 * the byte count it wrote, and a 64-bit shift is a no-op in Java rather than a clear, so a
 * full container would replay its bytes. Callers add at most 32 bits at a time and
 * {@link #addBits} keeps a 56-bit ceiling; {@link #append} leaves the bound to its caller.
 */
public final class BitWriter {

    private byte[] out;
    private int pos;
    private long container;
    private int bits;

    public void reset(byte[] array, int offset) {
        this.out = array;
        this.pos = offset;
        this.container = 0;
        this.bits = 0;
    }

    public void addBits(int value, int count) {
        if (bits + count > 56) {
            flushBytes();
        }
        container |= (value & Bits.mask64(count)) << bits;
        bits += count;
    }

    /** Adds a non-negative value already proven to fit in {@code count} bits. */
    void addBitsUnchecked(int value, int count) {
        assert count >= 0 && count < Integer.SIZE && value >= 0
                && (value >>> count) == 0;
        if (bits + count > 56) {
            flushBytes();
        }
        container |= (long) value << bits;
        bits += count;
    }

    /**
     * Appends bits with no room test. The caller is responsible for the container never
     * reaching 64 pending bits - see the class comment for why that bound is exclusive.
     */
    void append(int value, int count) {
        assert count >= 0 && count < Integer.SIZE && value >= 0 && (value >>> count) == 0;
        assert bits + count < Long.SIZE : "container would reach 64 pending bits";
        container |= (long) value << bits;
        bits += count;
    }

    /**
     * Appends the low {@code count} bits of {@code value} with no room test. The caller
     * is responsible for the container never reaching 64 pending bits.
     */
    void appendMasked(int value, int count) {
        assert bits + count < Long.SIZE : "container would reach 64 pending bits";
        long mask = (1L << count) - 1;
        container |= (value & mask) << bits;
        bits += count;
    }

    /** Writes all complete bytes; keeps up to 7 pending bits. */
    public void flush() {
        flushBytes();
        if (bits > 0) {
            out[pos++] = (byte) container;
            container >>>= 8;
            bits = 0;
        }
    }

    /** Writes complete bytes only; preserves a partial byte in the container. */
    public void flushBytes() {
        int bytes = bits >>> 3;
        if (bytes == 0) return;
        if (pos + 8 <= out.length) {
            // Unaligned little-endian VarHandle store; bytes above the logical end
            // are scratch and will be overwritten by subsequent output.
            Bits.putLong(out, pos, container);
            pos += bytes;
            container >>>= bytes << 3;
            bits &= 7;
            return;
        }
        while (bytes-- > 0) {
            out[pos++] = (byte) container;
            container >>>= 8;
            bits -= 8;
        }
    }

    /**
     * Terminates the stream: appends the format-mandated final {@code 1} marker bit,
     * then flushes everything including the zero-padded partial byte.
     */
    public void close() {
        addBitsUnchecked(1, 1);
        flush();
        bits = 0;
        container = 0;
    }

    public int position() {
        return pos + ((bits + 7) >>> 3);
    }

    public int rawPosition() {
        return pos;
    }

    /** Bits accumulated but not yet written out. */
    public int bitsInFlight() {
        return bits;
    }
}

package dev.jzstd.internal;

import java.lang.invoke.MethodHandles;
import java.lang.invoke.VarHandle;
import java.nio.ByteOrder;
import java.util.Arrays;

/**
 * Little-endian word access on byte arrays plus bit twiddling helpers.
 * VarHandle-based loads compile to single machine instructions on HotSpot.
 */
public final class Bits {

    private static final boolean VECTORIZED_MATCH =
            !Boolean.getBoolean("jzstd.scalarMatch");

    private static final VarHandle LONG_HANDLE =
            MethodHandles.byteArrayViewVarHandle(long[].class, ByteOrder.LITTLE_ENDIAN);
    private static final VarHandle INT_HANDLE =
            MethodHandles.byteArrayViewVarHandle(int[].class, ByteOrder.LITTLE_ENDIAN);
    private static final VarHandle SHORT_HANDLE =
            MethodHandles.byteArrayViewVarHandle(short[].class, ByteOrder.LITTLE_ENDIAN);

    private Bits() {}

    public static long getLong(byte[] array, int index) {
        return (long) LONG_HANDLE.get(array, index);
    }

    public static void putLong(byte[] array, int index, long value) {
        LONG_HANDLE.set(array, index, value);
    }

    public static int getInt(byte[] array, int index) {
        return (int) INT_HANDLE.get(array, index);
    }

    public static void putInt(byte[] array, int index, int value) {
        INT_HANDLE.set(array, index, value);
    }

    public static short getShort(byte[] array, int index) {
        return (short) SHORT_HANDLE.get(array, index);
    }

    public static void putShort(byte[] array, int index, short value) {
        SHORT_HANDLE.set(array, index, value);
    }

    /** Reads {@code len} bytes (1..7) at {@code index} as a little-endian value; missing high bytes are zero. */
    public static long readPartialLong(byte[] array, int index, int len) {
        long value = 0;
        for (int i = len - 1; i >= 0; i--) {
            value = (value << 8) | (array[index + i] & 0xFFL);
        }
        return value;
    }

    /** Inverse of {@link #readPartialLong}; writes exactly {@code len} low bytes. */
    public static void writePartialLong(byte[] array, int index, long value, int len) {
        for (int i = 0; i < len; i++) {
            array[index + i] = (byte) value;
            value >>>= 8;
        }
    }

    /** Index (0..63) of the highest set bit; returns -1 when zero. */
    public static int highBit(long value) {
        return 63 - Long.numberOfLeadingZeros(value);
    }

    public static int highBit(int value) {
        return 31 - Integer.numberOfLeadingZeros(value);
    }

    /** Number of bytes needed to encode {@code value} little-endian without leading zero bytes (0 -> 1). */
    public static int byteWidth(int value) {
        return Math.max(1, (32 - Integer.numberOfLeadingZeros(value) + 7) >>> 3);
    }

    public static int mask(int bits) {
        return bits >= 32 ? -1 : (1 << bits) - 1;
    }

    public static long mask64(int bits) {
        return bits >= 64 ? -1L : (1L << bits) - 1;
    }

    /**
     * Length of the common prefix of two ranges in the same array. Long ranges use
     * the JDK's vectorized mismatch intrinsic; tiny ranges avoid its setup overhead.
     */
    public static int commonPrefix(byte[] array, int left, int right, int maxLength) {
        if (VECTORIZED_MATCH && maxLength >= 16) {
            int mismatch = Arrays.mismatch(array, left, left + maxLength,
                    array, right, right + maxLength);
            return mismatch < 0 ? maxLength : mismatch;
        }
        int length = 0;
        while (length + Long.BYTES <= maxLength) {
            long difference = getLong(array, left + length)
                    ^ getLong(array, right + length);
            if (difference != 0) {
                return length + (Long.numberOfTrailingZeros(difference) >>> 3);
            }
            length += 8;
        }
        while (length < maxLength && array[left + length] == array[right + length]) {
            length++;
        }
        return length;
    }

    /**
     * Common prefix without the vectorized intrinsic. Parsers that extend a candidate per
     * scanned position see mostly short matches, where {@code Arrays.mismatch}'s setup
     * costs more than the word loop it replaces.
     */
    public static int commonPrefixScalar(byte[] array, int left, int right,
                                         int maxLength) {
        int length = 0;
        while (length + Long.BYTES <= maxLength) {
            long difference = getLong(array, left + length)
                    ^ getLong(array, right + length);
            if (difference != 0) {
                return length + (Long.numberOfTrailingZeros(difference) >>> 3);
            }
            length += Long.BYTES;
        }
        while (length < maxLength && array[left + length] == array[right + length]) {
            length++;
        }
        return length;
    }

    /**
     * Length of the common suffix immediately preceding two exclusive positions.
     * A single-byte peel keeps the no-extension case cheap; longer suffixes compare
     * whole words from their high byte toward the beginning of each range.
     */
    public static int commonSuffix(byte[] array, int leftEnd, int rightEnd,
                                   int maxLength) {
        if (maxLength <= 0
                || array[leftEnd - 1] != array[rightEnd - 1]) return 0;
        int length = 1;
        while (length + Long.BYTES <= maxLength) {
            int left = leftEnd - length - Long.BYTES;
            int right = rightEnd - length - Long.BYTES;
            long difference = getLong(array, left) ^ getLong(array, right);
            if (difference != 0) {
                return length + (Long.numberOfLeadingZeros(difference) >>> 3);
            }
            length += Long.BYTES;
        }
        while (length < maxLength
                && array[leftEnd - length - 1] == array[rightEnd - length - 1]) {
            length++;
        }
        return length;
    }

}

package dev.jzstd.internal;

import dev.jzstd.Zstd;
import dev.jzstd.ZstdException;

/**
 * Compresses a single block using the appropriate match-finding strategy.
 * Includes verify-after-write to guarantee reference decoder compatibility.
 */
public final class BlockCompressor {


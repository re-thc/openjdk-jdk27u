# A pure make test that can run through the real prebuilt-test entry point.
# It intentionally needs neither a compiler nor a jtreg installation.
include MakeFileStart.gmk
include UtilsForTests.gmk
include Modules.gmk

$(call AssertEquals, $(ENABLE_DESKTOP), false, Prebuilt desktop policy)
$(call AssertEquals, $(ENABLE_HEADLESS_ONLY), true, Prebuilt headless policy)
$(call AssertEquals, $(SERVER_JVM_COLLECTORS), g1gc serialgc zgc, Prebuilt collector allowlist)
$(call AssertEquals, $(origin SERVER_JVM_COLLECTORS), override, Prebuilt collector policy must be pinned)
ifeq ($(strip $(JVM_VARIANTS)), )
  $(error Prebuilt JVM variants are missing)
endif
$(foreach v, $(JVM_VARIANTS), \
    $(call AssertEquals, $(sort $(filter %gc, $(JVM_FEATURES_$v))), $(SERVER_JVM_COLLECTORS), Prebuilt variant collectors))
$(call AssertEquals, $(filter java.desktop java.datatransfer java.se jdk.jconsole, $(call FindAllModules)), , Prebuilt module exclusions)

all:
	$(ECHO) "Prebuilt server policy and module graph passed."

include MakeFileEnd.gmk

include MakeFileStart.gmk
include Modules.gmk
include UtilsForTests.gmk

ifeq ($(ENABLE_DESKTOP), false)
  ALL_MODULES := $(call FindAllModules)
  EXCLUDED := java.desktop java.datatransfer java.se jdk.accessibility jdk.editpad \
      jdk.hotspot.agent jdk.jconsole jdk.jpackage jdk.unsupported.desktop
  $(call AssertEquals, $(filter $(EXCLUDED), $(ALL_MODULES)), , Excluded modules in graph)
  $(call AssertEquals, $(filter $(EXCLUDED), $(call FindImportedModules)), , Excluded imported modules)
  REQUIRED := java.base java.compiler java.logging java.management java.sql jdk.attach \
      jdk.compiler jdk.javadoc jdk.jdeps jdk.jdi jdk.jfr jdk.jlink jdk.jshell jdk.management.agent
  $(call AssertEquals, $(filter-out $(ALL_MODULES), $(REQUIRED)), , Missing supported modules)
  $(call AssertEquals, $(findstring *, $(call GetModuleSourcePathFlags)), , Wildcard module source path)
  $(foreach m, $(EXCLUDED), \
      $(call AssertEquals, $(findstring --module-source-path $(m)=, $(call GetModuleSourcePathFlags)), , Excluded source path))
  ifeq ($(TEST_HEADLESS_IMPORTS), true)
    $(call AssertEquals, $(call FindImportedModules), server.extra, Allowed imported module lost)
  endif

  # Exercise the actual launcher/library snippets for each target, with native
  # compilation macros stubbed. Native compilation itself is checked after a build.
  ifeq ($(TEST_HEADLESS_GRAPH), true)
    MODULE := java.base
    INCLUDE_GUARD_common/modules/LauncherCommon.gmk := true
    SetupBuildLauncher = $(eval TEST_LAUNCHERS += $(strip $1))
    SetupJdkExecutable =
    SetupJdkLibrary =
    include $(TOPDIR)/make/modules/java.base/Launcher.gmk
    include $(TOPDIR)/make/modules/java.base/lib/CoreLibraries.gmk
    $(call AssertEquals, $(filter javaw, $(TEST_LAUNCHERS)), , GUI Windows launcher)
    $(call AssertEquals, $(filter java keytool, $(TEST_LAUNCHERS)), java keytool, Missing command-line launchers)
    $(call AssertEquals, $(filter -DHEADLESS, $(LIBJLI_CFLAGS)), -DHEADLESS, Launcher desktop code enabled)
    $(call AssertEquals, $(filter splashscreen_stubs.c, $(LIBJLI_EXCLUDE_FILES)), splashscreen_stubs.c, Splash sources enabled)
    $(call AssertEquals, $(LIBJLI_LIBS_macosx) $(LIBJLI_LIBS_windows), , GUI launcher libraries)
    JVM_VARIANT := server
    check-jvm-feature = $(if $(filter $1, $(JVM_FEATURES_server)),true,false)
    include $(TOPDIR)/make/hotspot/lib/JvmFeatures.gmk
    ifeq ($(OPENJDK_TARGET_OS), windows)
      $(call AssertEquals, $(filter -DHEADLESS, $(JVM_CFLAGS_FEATURES)), -DHEADLESS, HotSpot desktop code enabled)
    endif
  endif
endif

verify-graph:
	$(ECHO) "Headless graph passed: $(OPENJDK_TARGET_OS)/$(OPENJDK_TARGET_CPU)"

matrix:
	+$(MAKE) -I$(TOPDIR)/make/common/modules -f TestHeadless.gmk TEST_HEADLESS_GRAPH=true OPENJDK_TARGET_OS=linux OPENJDK_TARGET_OS_TYPE=unix OPENJDK_TARGET_CPU=x86_64 verify-graph
	+$(MAKE) -I$(TOPDIR)/make/common/modules -f TestHeadless.gmk TEST_HEADLESS_GRAPH=true OPENJDK_TARGET_OS=linux OPENJDK_TARGET_OS_TYPE=unix OPENJDK_TARGET_CPU=aarch64 verify-graph
	+$(MAKE) -I$(TOPDIR)/make/common/modules -f TestHeadless.gmk TEST_HEADLESS_GRAPH=true OPENJDK_TARGET_OS=macosx OPENJDK_TARGET_OS_TYPE=unix OPENJDK_TARGET_CPU=aarch64 verify-graph
	+$(MAKE) -I$(TOPDIR)/make/common/modules -f TestHeadless.gmk TEST_HEADLESS_GRAPH=true OPENJDK_TARGET_OS=windows OPENJDK_TARGET_OS_TYPE=windows OPENJDK_TARGET_CPU=x86_64 verify-graph

probes:
	$(BASH) $(TOPDIR)/test/make/autoconf/test-headless.sh "$(AUTOCONF)" "$(TOPDIR)" "$(TEST_SUPPORT_DIR)/headless"

direct-targets:
	$(MKDIR) -p $(TEST_SUPPORT_DIR)/headless-stale/jdk/modules/java.desktop
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk java.desktop-java > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'excluded by this configuration' $(TEST_SUPPORT_DIR)/headless-direct.log
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/CompileJavaModules.gmk MODULE=java.desktop > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'excluded by this configuration' $(TEST_SUPPORT_DIR)/headless-direct.log
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/ModuleWrapper.gmk MODULE=java.desktop MAKEFILE_PREFIX=Lib > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'excluded by this configuration' $(TEST_SUPPORT_DIR)/headless-direct.log
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk JDK_OUTPUTDIR=$(TEST_SUPPORT_DIR)/headless-stale/jdk print-modules > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'Stale excluded module outputs' $(TEST_SUPPORT_DIR)/headless-direct.log
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk ENABLE_DESKTOP=true print-modules > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'This fork requires' $(TEST_SUPPORT_DIR)/headless-direct.log
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk JVM_FEATURES_server='g1gc serialgc zgc parallelgc' print-modules > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'This fork requires collectors' $(TEST_SUPPORT_DIR)/headless-direct.log
	@if $(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk SERVER_JVM_COLLECTORS='g1gc parallelgc serialgc zgc' JVM_FEATURES_server='g1gc parallelgc serialgc zgc' print-modules > $(TEST_SUPPORT_DIR)/headless-direct.log 2>&1; then exit 1; fi
	$(GREP) -q 'This fork requires collectors' $(TEST_SUPPORT_DIR)/headless-direct.log
	+$(MAKE) -n -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk ENABLE_DESKTOP=true OUTPUTDIR=$(TEST_SUPPORT_DIR)/headless-clean clean > $(TEST_SUPPORT_DIR)/headless-clean.log
	+$(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/Main.gmk SPEC=$(dir $(SPEC))buildjdk-spec.gmk CREATING_BUILDJDK=true print-modules > $(TEST_SUPPORT_DIR)/headless-buildjdk.log

imports:
	$(MKDIR) -p $(TEST_SUPPORT_DIR)/headless-imports/java.desktop $(TEST_SUPPORT_DIR)/headless-imports/jdk.jconsole $(TEST_SUPPORT_DIR)/headless-imports/server.extra
	+$(MAKE) -f TestHeadless.gmk TEST_HEADLESS_IMPORTS=true IMPORT_MODULES_CLASSES=$(TEST_SUPPORT_DIR)/headless-imports verify-graph

module-info:
	$(MKDIR) -p $(TEST_SUPPORT_DIR)/headless-module-info
	$(FIXPATH) $(JAVAC) -d $(TEST_SUPPORT_DIR)/headless-module-info $(TOPDIR)/make/jdk/src/classes/build/tools/module/GenModuleInfoSource.java $(TOPDIR)/make/jdk/src/classes/build/tools/module/ModuleInfoExtraTest.java
	$(CD) $(TEST_SUPPORT_DIR)/headless-module-info && $(FIXPATH) $(JAVA) -cp . build.tools.module.ModuleInfoExtraTest

# Exercise the actual imported-source generation and product javac recipes.
# A separate module output root keeps fixture classes out of the target JDK.
IMPORT_SOURCE_TEST := $(TEST_SUPPORT_DIR)/headless-module-info/gen-module-info-test/source-imports
IMPORT_SUPPORT_TEST := $(TEST_SUPPORT_DIR)/headless-source-imports
# Resolve platform modules from the built JDK, while exposing only fixture
# source modules. A separate -d directory must not implicitly rebuild java.base.
IMPORT_SOURCE_ARGS := IMPORT_MODULES_SRC=$(IMPORT_SOURCE_TEST) \
    SUPPORT_OUTPUTDIR=$(IMPORT_SUPPORT_TEST) TOP_SRC_DIRS= \
    MODULEPATH=$(call PathList, $(JDK_OUTPUTDIR)/modules $(IMPORT_SUPPORT_TEST)/classes)
source-imports: module-info
	+$(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/common/modules/GensrcModuleInfo.gmk MODULE=server.extra $(IMPORT_SOURCE_ARGS) all
	+$(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/common/modules/GensrcModuleInfo.gmk MODULE=server.open $(IMPORT_SOURCE_ARGS) all
	+$(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/CompileJavaModules.gmk MODULE=client.keep $(IMPORT_SOURCE_ARGS) client.keep_BIN=$(IMPORT_SUPPORT_TEST)/classes all
	+$(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/CompileJavaModules.gmk MODULE=server.extra $(IMPORT_SOURCE_ARGS) server.extra_BIN=$(IMPORT_SUPPORT_TEST)/classes all
	+$(MAKE) -I$(TOPDIR)/make/common -f $(TOPDIR)/make/CompileJavaModules.gmk MODULE=server.open $(IMPORT_SOURCE_ARGS) server.open_BIN=$(IMPORT_SUPPORT_TEST)/classes all
	@test ! -e $(IMPORT_SUPPORT_TEST)/classes/java.desktop
	@test ! -e $(IMPORT_SUPPORT_TEST)/classes/java.base

include NativeCompilation.gmk
$(eval $(call SetupNativeCompilation, HEADLESS_MESSAGE_BOX_TEST, \
    NAME := HeadlessMessageBoxTest, \
    TYPE := EXECUTABLE, \
    TARGET_TYPE := BUILD, \
    LINK_TYPE := C++, \
    SRC := $(TOPDIR)/test/make/native, \
    CFLAGS := -I$(TOPDIR)/src/hotspot/os/windows, \
    OBJECT_DIR := $(TEST_SUPPORT_DIR)/headless-native/objs, \
    OUTPUT_DIR := $(TEST_SUPPORT_DIR)/headless-native, \
))

native-diagnostics: $(HEADLESS_MESSAGE_BOX_TEST)
	$(TEST_SUPPORT_DIR)/headless-native/HeadlessMessageBoxTest$(EXECUTABLE_SUFFIX)

all: matrix probes direct-targets imports source-imports native-diagnostics
.PHONY: verify-graph matrix probes direct-targets imports module-info source-imports native-diagnostics
include MakeFileEnd.gmk

      "heap_base": "0x100000000000",
      "old_sequence": "1->3 for in-place source pages; 1->1 for normal source pages"
    }
  ],
  "operation_contract": {
    "regex_replace": "Java Pattern/Matcher syntax, with $N replacement group references. Replace all matches; require the stated exact 'matches' count.",
    "insert_after_line": "Require exactly one line equal to anchor (excluding LF), insert text immediately after its LF.",
    "remove_line": "Require exactly one line equal to line; remove that complete line and its LF.",
    "move_line_after": "Require exactly one exact line and anchor; remove line including LF, then insert after anchor including its LF.",
    "move_line_before": "As move_line_after, but insert before anchor.",
    "move_regex_line_after": "Find exactly one complete line by Pattern.matcher(line without LF).matches(); move after the exact anchor.",
    "ordering": "Start from the named unmodified base for every case. Apply operations sequentially. No mutation result is reused as another case's base.",
    "encoding": "UTF-8 without BOM, LF endings, one final LF. Files are synthetic parser input, not captured test execution."
  },

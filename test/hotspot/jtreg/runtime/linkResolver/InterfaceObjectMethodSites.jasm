//
//     static int hashCodeOf(Runnable r)             { return r.hashCode(); }
//     static String toStringOf(Runnable r)          { return r.toString(); }
//     static boolean equalsOf(Runnable r, Object o) { return r.equals(o); }
//     static Class<?> getClassOf(Runnable r)        { return r.getClass(); }
//     static int firstHashCodeOf(Supplier<?> s)     { return s.hashCode(); }
//
// InterfaceObjectMethodBadHash overrides hashCode() with a method that is not
// public, which javac would reject as well.

super public class InterfaceObjectMethodSites version 60:0 {


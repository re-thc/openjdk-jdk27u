lassign $argv classpath java provider classname
spawn $java --add-modules=jdk.internal.le -Djdk.console=$provider \
    -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dstdin.encoding=windows-1252 \
    -classpath $classpath $classname retry
set timeout 30
expect {
    eof { }
    timeout {
        catch {exec kill -9 [exp_pid]}
        catch {close}
        catch {wait}
        exit 1
    }
}
set result [wait]
exit [lindex $result 3]

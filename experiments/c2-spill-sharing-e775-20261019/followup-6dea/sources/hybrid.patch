+    auto no_lifetime_extension = [&](Node* retained, Node* redundant, Block* block, uint from) {
+      uint last_retained = 0;
+      uint last_redundant = 0;
+      uint seen = 0;
+      for (uint at = from + 1; at < block->number_of_nodes(); at++) {
+        Node* use = block->get_node(at);
